---
// The Deza mark as a solid gold 3D piece. As it comes into view it turns in
// from the side and settles, then sways slowly; scrolling tilts it a little
// and, on desktop, it leans toward the pointer. three.js loads only when the
// mark comes near the screen and draws only while it is on screen. Until
// then, and for people who turn motion off or have no WebGL, the flat gold
// mark shows instead, at the same size and place.
import fs from "node:fs";
import path from "node:path";

interface Props {
  /** Widest the mark gets, in px (desktop). Phones get about a third of the screen width. */
  size?: number;
}

const { size = 220 } = Astro.props;
const svg = fs.readFileSync(path.join(process.cwd(), "public/brand/mark.svg"), "utf8");
const view = svg.match(/viewBox="([^"]+)"/)![1];
const d = svg.match(/<path[^>]*\sd="([^"]+)"/)![1];
const [, , vw, vh] = view.split(/[\s,]+/).map(Number);
---

<div class="mark3d" style={`--s:${size}px;--ratio:${vw}/${vh}`} data-mark3d data-d={d} data-view={view} aria-hidden="true">
  <svg class="flat" viewBox={view}><path d={d} fill="currentColor" fill-rule="evenodd"></path></svg>
</div>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const gl = (() => {
    try {
      return !!document.createElement("canvas").getContext("webgl2");
    } catch {
      return false;
    }
  })();

  if (!reduce && gl) {
    for (const host of document.querySelectorAll<HTMLElement>("[data-mark3d]")) {
      const io = new IntersectionObserver(
        async ([e]) => {
          if (!e.isIntersecting) return;
          io.disconnect();
          try {
            const { mount } = await import("../scripts/mark3d");
            mount(host);
          } catch {
            // Offline or no GPU after all: the flat mark stays.
          }
        },
        { rootMargin: "300px 0px" },
      );
      io.observe(host);
    }
  }
</script>

<style>
  /* The box is the mark itself, so it lines up with the text around it. */
  .mark3d {
    position: relative;
    width: clamp(112px, 33vw, var(--s));
    aspect-ratio: var(--ratio);
    color: var(--gold);
  }

  .flat {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 0.35s ease;
  }

  /* The canvas overhangs the box by a fifth on every side, so the piece can
     turn without being clipped. mark3d.ts reads this to frame the camera. */
  .mark3d :global(canvas) {
    position: absolute;
    inset: -20%;
    width: 140%;
    height: 140%;
    pointer-events: none;
  }

  .live .flat {
    opacity: 0;
  }
</style>
