---
// A concept of the rider app's request screen, built in HTML so it stays sharp
// and weighs almost nothing. Swap for a real screenshot once the screen exists.
import Icon from "./Icon.astro";

interface Props {
  t: {
    from: string;
    fromValue: string;
    to: string;
    toValue: string;
    fare: string;
    eta: string;
    button: string;
  };
}

const { t } = Astro.props;
---

<div class="phone" aria-hidden="true">
  <div class="screen">
    <div class="status"><span>9:41</span><span class="notch"></span><span>4G</span></div>

    <svg class="map" viewBox="0 0 300 330" preserveAspectRatio="xMidYMid slice">
      <g class="blocks">
        <rect x="18" y="20" width="70" height="52" rx="6" />
        <rect x="104" y="20" width="96" height="52" rx="6" />
        <rect x="216" y="20" width="70" height="88" rx="6" />
        <rect x="18" y="88" width="120" height="70" rx="6" />
        <rect x="154" y="88" width="46" height="70" rx="6" />
        <rect x="216" y="124" width="70" height="80" rx="6" />
        <rect x="18" y="174" width="56" height="90" rx="6" />
        <rect x="90" y="174" width="110" height="40" rx="6" />
        <rect x="90" y="230" width="58" height="74" rx="6" />
        <rect x="164" y="230" width="122" height="74" rx="6" />
      </g>
      <path class="route" d="M46 290 V166 H146 V80 H208 V44" />
      <circle class="pin-a" cx="46" cy="290" r="9" />
      <circle class="pin-a-dot" cx="46" cy="290" r="3.5" />
      <g class="pin-b" transform="translate(208 44)">
        <circle r="11" />
        <rect x="-4" y="-4" width="8" height="8" rx="1.5" />
      </g>
      <g class="keke" transform="translate(146 120)">
        <rect x="-13" y="-9" width="26" height="18" rx="6" />
        <circle cx="-6" cy="0" r="2" />
        <circle cx="6" cy="0" r="2" />
      </g>
    </svg>

    <div class="sheet">
      <div class="eta"><span class="live"></span>{t.eta}</div>
      <div class="trip">
        <div class="stop">
          <span class="dot a"></span>
          <div>
            <small>{t.from}</small>
            <strong>{t.fromValue}</strong>
          </div>
        </div>
        <div class="stop">
          <span class="dot b"></span>
          <div>
            <small>{t.to}</small>
            <strong>{t.toValue}</strong>
          </div>
        </div>
      </div>
      <div class="fare">
        <span>{t.fare}</span>
        <strong>₦600</strong>
      </div>
      <div class="cta">{t.button}</div>
    </div>

    <div class="tabbar">
      <span class="tab active"><Icon name="home" size={22} /><i></i></span>
      <span class="tab"><Icon name="wallet" size={22} /></span>
      <span class="tab"><Icon name="user" size={22} /></span>
    </div>
  </div>
</div>

<style>
  .phone {
    width: min(320px, 78vw);
    aspect-ratio: 320 / 660;
    padding: 10px;
    border-radius: 48px;
    background: #12161a;
    box-shadow:
      0 0 0 1.5px rgb(255 255 255 / 0.08) inset,
      0 50px 90px -30px rgb(0 0 0 / 0.65),
      0 0 0 1px rgb(0 0 0 / 0.4);
  }

  .screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 39px;
    background: var(--paper);
    color: var(--ink);
    display: flex;
    flex-direction: column;
  }

  .status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 24px 6px;
    font-size: 12px;
    font-weight: 600;
  }

  .notch {
    width: 84px;
    height: 22px;
    border-radius: 999px;
    background: #12161a;
  }

  .map {
    width: 100%;
    flex: 1;
    min-height: 0;
  }

  .blocks rect {
    fill: var(--ink-6);
  }

  .route {
    fill: none;
    stroke: var(--ink);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 520;
    stroke-dashoffset: 520;
    animation: draw 2.4s 0.4s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  .pin-a {
    fill: var(--gold);
    stroke: var(--ink);
    stroke-width: 2;
  }

  .pin-a-dot {
    fill: var(--ink);
  }

  .pin-b circle {
    fill: var(--ink);
  }

  .pin-b rect {
    fill: var(--gold);
  }

  .keke rect {
    fill: var(--gold);
    stroke: var(--ink);
    stroke-width: 2;
  }

  .keke circle {
    fill: var(--ink);
  }

  .keke {
    animation: bob 2.8s ease-in-out infinite;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes bob {
    50% {
      transform: translate(146px, 124px);
    }
  }

  .sheet {
    margin: 0 10px;
    padding: 14px 14px 12px;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 10px 30px -12px rgb(30 35 41 / 0.25);
    display: grid;
    gap: 10px;
  }

  .eta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-70);
  }

  .live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 4px var(--gold-20);
  }

  .trip {
    display: grid;
    gap: 8px;
  }

  .stop {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .stop small {
    display: block;
    font-size: 10.5px;
    color: var(--ink-55);
    line-height: 1.2;
  }

  .stop strong {
    font-size: 13.5px;
    line-height: 1.25;
  }

  .dot {
    width: 10px;
    height: 10px;
    flex: none;
  }

  .dot.a {
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 2px var(--ink);
  }

  .dot.b {
    border-radius: 2px;
    background: var(--ink);
  }

  .fare {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-top: 10px;
    border-top: 1px solid var(--ink-10);
    font-size: 12px;
    color: var(--ink-70);
  }

  .fare strong {
    font-size: 22px;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .cta {
    display: grid;
    place-items: center;
    height: 44px;
    border-radius: 14px;
    background: var(--gold);
    font-weight: 700;
    font-size: 15px;
  }

  .tabbar {
    margin: 12px 18px 16px;
    height: 58px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper-55);
    display: flex;
    align-items: center;
    justify-content: space-around;
    box-shadow: var(--shadow-floating);
  }

  .tab {
    position: relative;
    display: grid;
    place-items: center;
  }

  .tab.active {
    color: var(--gold);
  }

  .tab i {
    position: absolute;
    bottom: -9px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--gold);
  }
</style>
