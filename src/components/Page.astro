---
import Base from "../layouts/Base.astro";
import Photo from "./Photo.astro";
import Logo from "./Logo.astro";
import StoreBadges from "./StoreBadges.astro";
import ScreenUI from "./ScreenUI.astro";
import Icon from "./Icon.astro";
import { copy, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const home = lang === "en" ? "/" : "/ha/";
const words = t.manifesto.split(" ");
// The waitlist endpoint is decided later. Until it is set, the form says
// sign-ups open soon instead of pretending to save anything.
const waitlistUrl = import.meta.env.PUBLIC_WAITLIST_URL ?? "";
---

<Base lang={lang} title={t.meta.title} description={t.meta.description}>
  <header class="top" data-top>
    <div class="wrap bar">
      <a class="brand" href={home}><Logo height={20} /></a>
      <nav aria-label="Main">
        <a href="#products">{t.nav.products}</a>
        <a href="#how">{t.nav.how}</a>
        <a href="#safety">{t.nav.safety}</a>
        <a href="#earn">{t.nav.earn}</a>
      </nav>
      <div class="bar-end">
        <a class="lang" href={t.nav.switchHref} hreflang={lang === "en" ? "ha" : "en"}>{t.nav.switchLabel}</a>
        <a class="btn btn-gold btn-sm" href="#join">{t.nav.cta}</a>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero: Kano in motion -->
    <section class="hero">
      <div class="hero-media">
        <Photo name="city-band" mobile="city-band-mobile" alt={t.hero.photoAlt} class="hero-photo" eager />
      </div>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <span class="kicker load" style="--d:0">{t.hero.eyebrow}</span>
        <h1>
          {t.hero.title.map((w, i) => <span class:list={["load", { gold: i === 2 }]} style={`--d:${i + 1}`}>{w}</span>)}
        </h1>
        <p class="lead load" style="--d:4">{t.hero.lead}</p>
        <div class="hero-actions load" style="--d:5">
          <a class="btn btn-gold" href="#join">{t.hero.cta}<Icon name="arrow" size={18} stroke={2.25} /></a>
          <StoreBadges label={t.hero.soon} />
        </div>
      </div>
    </section>

    <!-- Kano neighbourhoods -->
    <div class="marquee" aria-hidden="true">
      <div class="track">
        {
          [0, 1].map(() => (
            <div class="run">
              {t.marquee.map((m) => (
                <span>
                  {m}
                  <i />
                </span>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <!-- Manifesto: words light up as you read -->
    <section class="manifesto">
      <div class="wrap">
        <p class="say" data-say>
          {words.map((w) => <span>{w} </span>)}
        </p>
      </div>
    </section>

    <!-- Products -->
    <section id="products" class="products">
      <div class="wrap">
        <div class="head reveal">
          <span class="kicker dark">{t.products.kicker}</span>
          <h2>{t.products.title}</h2>
        </div>
        <div class="cards">
          {
            t.products.items.map((p, i) => (
              <article class="card reveal" style={`--i:${i}`}>
                <div class="card-media">
                  <Photo name={p.photo} alt={p.photoAlt} class="card-photo" />
                  <span class:list={["status", { first: i === 0 }]}>{p.status}</span>
                </div>
                <h3>{p.name}</h3>
                <p>{p.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- How it works: sticky phone, screen follows the steps -->
    <section id="how" class="how" data-steps data-step="1">
      <div class="wrap how-grid">
        <div class="how-copy">
          <div class="head">
            <span class="kicker">{t.how.kicker}</span>
            <h2>{t.how.title}</h2>
          </div>
          <ol class="steps">
            {
              t.how.steps.map((s, i) => (
                <li data-step-item={i + 1}>
                  <span class="num">{i + 1}</span>
                  <div>
                    <h3>{s.title}</h3>
                    <p>{s.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="how-visual">
          <div class="phone-shot">
            <Photo name="phone-in-hand" alt={t.how.photoAlt} class="phone-photo" />
            <div class="screen-slot"><ScreenUI t={t.screen} /></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Honest numbers -->
    <section class="stats">
      <div class="wrap stat-row">
        {
          t.stats.map((s) => (
            <div class="stat reveal">
              <b>
                {s.prefix}
                <span data-count={s.value}>{s.value}</span>
                {s.suffix}
              </b>
              <span>{s.label}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Safety, at night -->
    <section id="safety" class="safety">
      <div class="parallax">
        <Photo name="night-ride" alt={t.safety.photoAlt} class="safety-photo" position="50% 60%" />
      </div>
      <div class="safety-shade" aria-hidden="true"></div>
      <div class="wrap safety-inner">
        <div class="head reveal">
          <span class="kicker">{t.safety.kicker}</span>
          <h2>{t.safety.title}</h2>
        </div>
        <ul class="safety-list">
          {
            t.safety.items.map((s, i) => (
              <li class="reveal" style={`--i:${i}`}>
                <Icon name={(["shield", "share", "tag"] as const)[i]} size={26} />
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Roadmap -->
    <section class="road">
      <div class="wrap">
        <div class="head reveal">
          <span class="kicker dark">{t.road.kicker}</span>
          <h2>{t.road.title}</h2>
        </div>
        <ol class="road-line">
          {
            t.road.steps.map((s, i) => (
              <li class:list={["reveal", { now: i === 0 }]} style={`--i:${i}`}>
                <span class="tag">{s.tag}</span>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Earn -->
    <section id="earn" class="earn">
      <div class="wrap earn-grid">
        <div class="earn-media reveal">
          <Photo name="driver-portrait" alt={t.earn.photoAlt} class="earn-photo" position="50% 35%" />
        </div>
        <div class="earn-copy reveal">
          <span class="kicker dark">{t.earn.kicker}</span>
          <h2>{t.earn.title}</h2>
          <p class="body">{t.earn.body}</p>
          <ul class="ticks">
            {
              t.earn.points.map((p) => (
                <li>
                  <Icon name="check" size={18} stroke={2.5} />
                  {p}
                </li>
              ))
            }
          </ul>
          <a class="btn btn-ink" href="#join" data-role="drive">{t.earn.cta}</a>
        </div>
      </div>
    </section>

    <!-- Join -->
    <section id="join" class="join">
      <Photo name="hero-keke" mobile="hero-keke-mobile" alt="" class="join-photo" position="75% 50%" />
      <div class="join-shade" aria-hidden="true"></div>
      <div class="wrap join-grid">
        <div class="join-copy reveal">
          <span class="kicker">{t.app.kicker}</span>
          <h2>{t.app.title}</h2>
          <p class="body">{t.app.body}</p>
          <StoreBadges label={t.hero.soon} />
        </div>
        <form
          class="form reveal"
          data-endpoint={waitlistUrl}
          data-msg-success={t.waitlist.success}
          data-msg-closed={t.waitlist.notOpen}
          data-msg-error={t.waitlist.error}
        >
          <label for={`wl-phone-${lang}`}>{t.waitlist.phone}</label>
          <input
            id={`wl-phone-${lang}`}
            name="phone"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            required
            pattern="[0-9+ ]{10,16}"
            placeholder={t.waitlist.phonePlaceholder}
          />
          <label for={`wl-area-${lang}`}>{t.waitlist.area}</label>
          <input id={`wl-area-${lang}`} name="area" type="text" autocomplete="address-level3" placeholder={t.waitlist.areaPlaceholder} />
          <fieldset>
            <legend>{t.waitlist.role}</legend>
            <div class="chips">
              <label><input type="radio" name="role" value="ride" checked /><span>{t.waitlist.roles.ride}</span></label>
              <label><input type="radio" name="role" value="send" /><span>{t.waitlist.roles.send}</span></label>
              <label><input type="radio" name="role" value="drive" /><span>{t.waitlist.roles.drive}</span></label>
            </div>
          </fieldset>
          <input type="hidden" name="lang" value={lang} />
          <button class="btn btn-gold" type="submit">{t.waitlist.submit}</button>
          <p class="fine">{t.waitlist.privacy}</p>
          <p class="status-msg" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap">
      <div class="foot-row">
        <span>{t.footer.tagline}</span>
        <span>© {new Date().getFullYear()} {t.footer.rights}</span>
      </div>
      <div class="foot-mark"><Logo height={120} /></div>
    </div>
  </footer>
</Base>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Header turns solid once you scroll past the hero.
  const top = document.querySelector<HTMLElement>("[data-top]");
  const onScroll = () => top?.classList.toggle("solid", scrollY > 40);
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Manifesto: each word brightens as the paragraph moves up the screen.
  const say = document.querySelector<HTMLElement>("[data-say]");
  const sayWords = say ? [...say.querySelectorAll("span")] : [];
  const paint = () => {
    if (!say) return;
    const r = say.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, (innerHeight * 0.85 - r.top) / (r.height + innerHeight * 0.35)));
    const lit = Math.round(p * sayWords.length);
    sayWords.forEach((w, i) => w.classList.toggle("lit", reduce || i < lit));
  };
  addEventListener("scroll", paint, { passive: true });
  paint();

  // How it works: the screen follows whichever step is in the middle.
  const how = document.querySelector<HTMLElement>("[data-steps]");
  const items = [...document.querySelectorAll<HTMLElement>("[data-step-item]")];
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting && how) {
          how.dataset.step = (e.target as HTMLElement).dataset.stepItem;
          items.forEach((it) => it.classList.toggle("active", it === e.target));
        }
      }
    },
    { rootMargin: "-45% 0px -45% 0px" },
  );
  items.forEach((it) => io.observe(it));
  items[0]?.classList.add("active");

  // Numbers count up once when they come into view.
  const counters = document.querySelectorAll<HTMLElement>("[data-count]");
  const co = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const el = e.target as HTMLElement;
        co.unobserve(el);
        const end = Number(el.dataset.count);
        if (reduce || end === 0) continue;
        const start = performance.now();
        const tick = (now: number) => {
          const k = Math.min(1, (now - start) / 900);
          el.textContent = String(Math.round(end * (1 - Math.pow(1 - k, 3))));
          if (k < 1) requestAnimationFrame(tick);
        };
        el.textContent = "0";
        requestAnimationFrame(tick);
      }
    },
    { threshold: 0.6 },
  );
  counters.forEach((c) => co.observe(c));

  // Buttons like "Register as a rider" pre-select the matching option.
  document.querySelectorAll<HTMLAnchorElement>("a[data-role]").forEach((a) => {
    a.addEventListener("click", () => {
      const radio = document.querySelector<HTMLInputElement>(`input[name=role][value=${a.dataset.role}]`);
      if (radio) radio.checked = true;
    });
  });

  const form = document.querySelector<HTMLFormElement>("form.form");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const status = form.querySelector<HTMLElement>(".status-msg")!;
    const button = form.querySelector<HTMLButtonElement>("button")!;
    const { endpoint, msgSuccess, msgClosed, msgError } = form.dataset;
    status.dataset.state = "";
    if (!endpoint) {
      status.textContent = msgClosed ?? "";
      return;
    }
    button.disabled = true;
    try {
      const res = await fetch(endpoint, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      if (!res.ok) throw new Error(String(res.status));
      status.textContent = msgSuccess ?? "";
      status.dataset.state = "ok";
      form.reset();
    } catch {
      status.textContent = msgError ?? "";
      status.dataset.state = "error";
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  h1,
  h2,
  h3 {
    font-family: var(--display);
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  h2 {
    font-size: clamp(32px, 4.8vw, 64px);
    line-height: 1.02;
  }

  .head {
    display: grid;
    gap: var(--md);
    max-width: 860px;
  }

  .kicker {
    color: var(--gold);
  }

  .kicker.dark {
    color: var(--ink);
  }

  .body {
    font-size: 18px;
    max-width: 46ch;
  }

  .btn-sm {
    min-height: 40px;
    padding: 0 16px;
    font-size: 14px;
    border-radius: 10px;
  }

  .btn-ink {
    background: var(--ink);
    color: var(--paper);
  }

  .btn-ink:hover {
    background: color-mix(in srgb, var(--ink) 85%, white);
  }

  /* Reveal on scroll. Resting state is fully visible; only browsers with
     scroll-driven animations get the rise-in. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
    .reveal {
      animation-name: rise;
      animation-fill-mode: both;
      animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
      animation-timeline: view();
      animation-range: entry calc(var(--i, 0) * 4%) entry calc(45% + var(--i, 0) * 4%);
    }
  }

  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(48px);
    }
  }

  /* Header */
  .top {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    color: var(--paper);
    background: linear-gradient(to bottom, rgb(16 19 23 / 0.55), transparent);
    transition:
      background-color 250ms,
      box-shadow 250ms;
  }

  .top.solid {
    background: color-mix(in srgb, var(--ink) 94%, transparent);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--paper-6);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--lg);
    height: 72px;
  }

  .brand {
    color: var(--paper);
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 28px;
    margin-inline: auto;
    font-size: 15px;
    font-weight: 500;
  }

  nav a,
  .lang {
    color: var(--paper-70);
    text-decoration: none;
    transition: color 150ms;
  }

  nav a:hover,
  .lang:hover {
    color: var(--paper);
  }

  .bar-end {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .lang {
    font-size: 14px;
    font-weight: 600;
    padding: 7px 13px;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1px var(--paper-12);
  }

  /* Hero */
  .hero {
    position: relative;
    min-height: clamp(640px, 100svh, 980px);
    display: grid;
    align-items: end;
    color: var(--paper);
    background: var(--ink);
    overflow: hidden;
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -2;
    animation: drift 18s ease-out both;
  }

  .hero-media :global(.hero-photo) {
    width: 100%;
    height: 100%;
  }

  @keyframes drift {
    from {
      transform: scale(1.12);
    }
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(0deg, rgb(16 19 23 / 0.95) 0%, rgb(16 19 23 / 0.55) 40%, rgb(16 19 23 / 0.1) 70%),
      linear-gradient(90deg, rgb(16 19 23 / 0.6) 0%, transparent 60%);
  }

  .hero-inner {
    display: grid;
    justify-items: start;
    gap: var(--lg);
    padding-top: 140px;
    padding-bottom: clamp(48px, 7vw, 88px);
  }

  .hero h1 {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.28em;
    max-width: 13ch;
    font-size: clamp(48px, 9vw, 140px);
    line-height: 0.95;
    font-weight: 700;
    letter-spacing: -0.05em;
  }

  .gold {
    color: var(--gold);
  }

  .load {
    animation: up 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--d) * 90ms + 150ms);
  }

  @keyframes up {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
  }

  .lead {
    max-width: 44ch;
    font-size: clamp(17px, 1.5vw, 20px);
    color: var(--paper-70);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 22px;
  }

  /* Marquee */
  .marquee {
    overflow: hidden;
    background: var(--gold);
    color: var(--ink);
    padding-block: 16px;
  }

  .track {
    display: flex;
    width: max-content;
    animation: slide 40s linear infinite;
  }

  .run {
    display: flex;
  }

  .run span {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    padding-right: 28px;
    font-family: var(--display);
    font-weight: 600;
    font-size: 20px;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .run i {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--ink);
    transform: rotate(45deg);
  }

  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }

  /* Manifesto */
  .manifesto {
    padding-block: clamp(96px, 14vw, 200px);
  }

  .say {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(28px, 4.2vw, 58px);
    line-height: 1.18;
    letter-spacing: -0.03em;
    max-width: 22ch;
    max-width: 1000px;
  }

  .say span {
    color: color-mix(in srgb, var(--ink) 18%, transparent);
    transition: color 300ms;
  }

  .say span:global(.lit) {
    color: var(--ink);
  }

  /* Products */
  .products {
    padding-bottom: clamp(96px, 12vw, 160px);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--lg);
    margin-top: var(--xxl);
  }

  .card {
    display: grid;
    gap: 12px;
    align-content: start;
    min-width: 0;
  }

  .card-media {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-lg);
    margin-bottom: 8px;
  }

  .card-media :global(.card-photo) {
    aspect-ratio: 4 / 5;
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .card:hover .card-media :global(.card-photo) {
    transform: scale(1.05);
  }

  .status {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 6px 12px;
    border-radius: var(--r-pill);
    background: rgb(250 246 236 / 0.92);
    color: var(--ink);
    font-size: 13px;
    font-weight: 700;
  }

  .status.first {
    background: var(--gold);
  }

  .card h3 {
    font-size: clamp(22px, 2vw, 28px);
  }

  .card p {
    color: var(--ink-70);
    max-width: 40ch;
  }

  /* How it works */
  .how {
    background: var(--ink);
    color: var(--paper);
    padding-block: clamp(96px, 12vw, 160px);
  }

  .how-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .how-copy {
    min-width: 0;
  }

  .steps {
    list-style: none;
    margin: var(--xxl) 0 0;
    padding: 0;
  }

  .steps li {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: var(--md);
    padding-block: clamp(48px, 18vh, 180px) var(--lg);
    opacity: 0.35;
    transition: opacity 400ms;
  }

  .steps li:first-child {
    padding-top: var(--lg);
  }

  .steps li:global(.active) {
    opacity: 1;
  }

  .num {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--paper-55);
    font-family: var(--display);
    font-weight: 700;
    transition:
      background-color 300ms,
      color 300ms;
  }

  .steps li:global(.active) .num {
    background: var(--gold);
    color: var(--ink);
    box-shadow: none;
  }

  .steps h3 {
    font-size: clamp(22px, 2.2vw, 30px);
    margin-bottom: 8px;
  }

  .steps p {
    color: var(--paper-70);
    font-size: 17px;
    max-width: 40ch;
  }

  .how-visual {
    position: sticky;
    top: 96px;
  }

  .phone-shot {
    position: relative;
    aspect-ratio: 1000 / 1252;
    max-width: 100%;
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .phone-shot :global(.phone-photo) {
    position: absolute;
    inset: 0;
  }

  /* Matches the black screen in phone-in-hand.webp */
  .screen-slot {
    position: absolute;
    left: 31.6%;
    top: 23.1%;
    width: 36.8%;
    height: 64.6%;
  }

  /* Stats */
  .stats {
    background: var(--gold);
    color: var(--ink);
    padding-block: clamp(56px, 7vw, 88px);
  }

  .stat-row {
