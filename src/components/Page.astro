---
import fs from "node:fs";
import path from "node:path";
import Base from "../layouts/Base.astro";
import Photo from "./Photo.astro";
import Logo from "./Logo.astro";
import StoreBadges from "./StoreBadges.astro";
import ScreenUI from "./ScreenUI.astro";
import Cruise from "./Cruise.astro";
import Mark3D from "./Mark3D.astro";
import Icon from "./Icon.astro";
import { copy, type Lang } from "../i18n";
import { findAsset, srcsets } from "../lib/pictures";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const home = lang === "en" ? "/" : "/ha/";
// The waitlist endpoint is decided later. Until it is set, the form says
// sign-ups open soon instead of pretending to save anything.
// The sign-up endpoint: the Cloudflare function in functions/api/waitlist.ts.
const waitlistUrl = import.meta.env.PUBLIC_WAITLIST_URL ?? "/api/waitlist";
// Cloudflare Turnstile (invisible bot check). Set at build time once the
// site key exists; without it the form still works, with the other guards.
// Official Deza WhatsApp line. wa.me opens a chat with a first message typed in.
const whatsapp = "2347079174330";
const waLink = `https://wa.me/${whatsapp}?text=${encodeURIComponent(t.contact.hello)}`;
// WhatsApp's own glyph (Simple Icons, CC0), drawn in the text colour.
const waGlyph = "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z";
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";

const has = (p: string) => fs.existsSync(path.join(process.cwd(), "public", p));
const firstOf = (...names: string[]) =>
  names.find((n) => ["webp", "jpg", "jpeg", "png"].some((e) => fs.existsSync(path.join(process.cwd(), "src/assets/photos", `${n}.${e}`))));

// Hero: a video when one is in public/video/, otherwise the two photos.
const heroVideo = has("video/hero.mp4") ? "/video/hero.mp4" : null;
// The hero still is the first thing people see, so the browser is told
// about it in the head, before it even reads the page.
const heroWidths = [640, 960, 1280, 1920];
const heroStill = heroVideo ? await srcsets(findAsset("posters/hero")!, heroWidths) : null;
const cityVideo = has("video/city.mp4") ? "/video/city.mp4" : null;
const courierPhoto = firstOf("courier-city", "delivery-hand")!;
const doorstepPhoto = firstOf("courier-doorstep", "delivery-hand")!;
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} ogAlt={t.meta.ogAlt} faq={t.faq.items}>
  {heroStill && <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={heroStill.avif} imagesizes="100vw" fetchpriority="high" />}
  <header class="top" data-top>
    <div class="wrap top-bar">
      <a class="brand" href={home} aria-label="Deza"><Logo height={19} motion="intro" /></a>
      <nav aria-label={t.nav.mainLabel}>
        <a href="#ride">{t.nav.ride}</a>
        <a href="#delivery">{t.nav.delivery}</a>
        <a href="#earn">{t.nav.earn}</a>
      </nav>
      <div class="bar-end">
        <a class="lang" href={t.nav.switchHref} hreflang={lang === "en" ? "ha" : "en"} lang={lang === "en" ? "ha" : "en"}>{t.nav.switchLabel}</a>
        <a class="btn btn-gold btn-sm" href="#join">{t.nav.cta}</a>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero: rides and deliveries, switching on their own -->
    <section class:list={["hero", { "has-video": heroVideo }]} data-hero data-mode="0">
      <div class="hero-media">
        {
          heroVideo ? (
            <>
              <Photo name="posters/hero" alt={t.hero.rideAlt} class="hero-poster" position="78% 50%" eager sizes="100vw" widths={heroWidths} />
              <video
                class="bg-video"
                muted
                loop
                playsinline
                preload="none"
                aria-hidden="true"
                data-av1="/video/hero-av1.mp4"
                data-mp4="/video/hero-1080.mp4"
                data-mp4-small="/video/hero.mp4"
              />
            </>
          ) : (
            <>
              <div class="layer l0">
                <Photo name="hero-keke" mobile="hero-keke-mobile" alt={t.hero.rideAlt} class="hero-photo" position="68% 50%" eager sizes="100vw" />
              </div>
              <div class="layer l1">
                <Photo name={courierPhoto} alt={t.hero.deliveryAlt} class="hero-photo" position="50% 40%" sizes="100vw" />
              </div>
            </>
          )
        }
      </div>
      <div class="hero-shade" aria-hidden="true"></div>

      <div class="wrap hero-inner">
        <h1>
          <span class="eyebrow load" style="--d:0">{t.hero.eyebrow}</span>{" "}
          <span class="title">
            {t.hero.title.map((w, i) => (
              <>
                {i > 0 && " "}
                <span class="word-mask">
                  <span class:list={["load-word", { gold: i === 2 }]} style={`--d:${i}`}>{w}</span>
                </span>
              </>
            ))}
          </span>
        </h1>

        <div class="hero-pick">
        <div class="modes load" style="--d:4" role="group" aria-label={t.hero.modesLabel}>
          {
            t.hero.modes.map((m, i) => (
              <button type="button" aria-pressed={i === 0 ? "true" : "false"} data-mode-btn={i}>
                <Icon name={i === 0 ? "pin" : "package"} size={16} stroke={2} />
                {m.label}
                <i class="fill" aria-hidden="true" />
              </button>
            ))
          }
        </div>

          <div class="leads load" style="--d:5">
            {t.hero.modes.map((m, i) => <p class:list={["lead", { on: i === 0 }]} data-lead={i} aria-hidden={i === 0 ? undefined : "true"}>{m.lead}</p>)}
          </div>
          <div class="hero-actions">
            <a class="btn btn-gold hero-cta load" style="--d:6" href="#join">{t.hero.cta}<Icon name="arrow" size={18} stroke={2.25} /></a>
            <div class="hero-stores load" style="--d:7">
              <StoreBadges label={t.hero.soon} />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Deza Ride: the phone plays through booking a keke, step by step -->
    <section id="ride" class="how" data-steps data-step="1">
      <div class="wrap how-grid">
        <div class="how-copy">
          <div class="head">
            <span class="chip chip-gold">{t.how.kicker} · {t.lanes.items[0].status}</span>
            <h2>{t.how.title}</h2>
          </div>
          <ol class="steps" data-stepper>
            {
              t.how.steps.map((s, i) => (
                <li>
                  <button type="button" data-step-btn={i + 1} aria-pressed={i === 0 ? "true" : "false"}>
                    <span class="num">{i + 1}</span>
                    <span class="step-text">
                      <span class="step-title">{s.title}</span>
                      <span class="step-body">{s.body}</span>
                    </span>
                    <i class="step-timer" aria-hidden="true" />
                  </button>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="how-visual">
          <div class="phone-shot">
            <div class="phone-zoom">
              <Photo name="phone-in-hand" alt={t.how.photoAlt} class="phone-photo" sizes="(max-width: 900px) 100vw, 46vw" widths={[480, 720, 1000]} />
              <div class="screen-slot" data-nosnippet><ScreenUI t={t.screen} /></div>
            </div>
          </div>
          <!-- Phones: the open step's words sit right under the phone, so the
               screen and what it means are on screen together. -->
          <div class="step-captions" aria-hidden="true" data-nosnippet>
            {
              t.how.steps.map((s, i) => (
                <p data-cap={i + 1}>
                  <b>{s.title}</b>
                  {s.body}
                </p>
              ))
            }
          </div>
        </div>
      </div>

      <ul id="safety" class="wrap trust">
        {
          t.safety.items.map((s, i) => (
            <li>
              <Icon name={(["shield", "share", "tag"] as const)[i]} size={22} />
              <div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Deza Delivery -->
    <section id="delivery" class="delivery">
      <div class="wrap d-grid">
        <div class="d-copy">
          <div class="head">
            <span class="chip chip-ink">{t.delivery.kicker} · {t.delivery.status}</span>
            <h2>{t.delivery.title}</h2>
            <p class="body">{t.delivery.body}</p>
          </div>

          <ol class="d-steps">
            {
              t.delivery.steps.map((s, i) => (
                <li>
                  <span class="d-num">{i + 1}</span>
                  <div>
                    <h3>{s.title}</h3>
                    <p>{s.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>

          <ul class="sends" aria-label={t.delivery.sendsTitle}>
            {t.delivery.sends.map((s, i) => (
              <li>
                <Icon name={(["doc", "bag", "store", "phone"] as const)[i]} size={16} />
                {s}
              </li>
            ))}
          </ul>
        </div>

        <div class="d-visual">
          <Photo name={doorstepPhoto} alt={t.delivery.photoAlt} class="d-photo" position="55% 45%" sizes="(max-width: 900px) 84vw, 36vw" widths={[480, 720, 960, 1280]} />
          <div class="device" data-nosnippet>
            <div class="device-screen"><ScreenUI t={t.screen} mode="delivery" /></div>
          </div>
        </div>
      </div>

      <div class="wrap">
        <div class="biz">
          <div class="biz-copy">
            <h3>{t.delivery.bizTitle}</h3>
            <p>{t.delivery.bizBody}</p>
          </div>
          <a class="btn btn-gold" href="#join" data-role="send">{t.delivery.cta}<Icon name="arrow" size={18} stroke={2.25} /></a>
        </div>
      </div>
    </section>

    <!-- Earn: the keke and the dispatch rider drive past, then the pitch -->
    <Cruise places={t.footer.areas} />

    <section id="earn" class="earn">
      <div class="wrap earn-grid">
        <h2 class="reveal">{t.earn.title.split(/(?<=\.) /).map((l, i) => <>{i > 0 && " "}<span class="line">{l}</span></>)}</h2>
        <div class="earn-copy reveal">
          <p class="body">{t.earn.body}</p>
          <ul class="ticks">
            {
              t.earn.points.map((p) => (
                <li>
                  <Icon name="check" size={18} stroke={2.5} />
                  {p}
                </li>
              ))
            }
          </ul>
          <a class="btn btn-ink earn-cta" href="#join" data-role="drive">{t.earn.cta}<Icon name="arrow" size={18} stroke={2.25} /></a>
        </div>
      </div>
    </section>

    <!-- Questions -->
    <section id="faq" class="faq">
      <div class="wrap faq-grid">
        <div class="head">
          <h2>{t.faq.title}</h2>
        </div>
        <div class="qs">
          {
            t.faq.items.map((f, i) => (
              <details>
                <summary>
                  {f.q}
                  <i aria-hidden="true" />
                </summary>
                <p>{f.a}</p>
              </details>
            ))
          }
          <p class="ask">
            {t.contact.ask}
            <a class="text-link wa" href={waLink} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d={waGlyph} /></svg>{t.contact.chat}</a>
          </p>
        </div>
      </div>
    </section>

    <!-- Join -->
    <section id="join" class="join">
      <div class="join-media">
        <Photo name="posters/city" alt="" class="join-photo" position="50% 85%" sizes="100vw" widths={[640, 960, 1280]} />
        {cityVideo && <video class="bg-video" muted loop playsinline preload="none" aria-hidden="true" data-av1="/video/city-av1.mp4" data-mp4={cityVideo} />}
      </div>
      <div class="join-shade" aria-hidden="true"></div>
      <div class="wrap join-grid">
        <div class="join-copy reveal">
          <Mark3D size={200} />
          <h2>{t.app.title}</h2>
          <p class="body">{t.app.body}</p>
        </div>
        <form
          class="form reveal"
          data-endpoint={waitlistUrl}
          data-msg-slow={t.waitlist.slowDown}
          data-msg-closed={t.waitlist.notOpen}
          data-msg-error={t.waitlist.error}
          data-msg-phone={t.waitlist.phoneError}
          novalidate
        >
          <div class="fields">
          <label for={`wl-phone-${lang}`}>{t.waitlist.phone}</label>
          <input
            id={`wl-phone-${lang}`}
            name="phone"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            required
            aria-describedby={`wl-phone-err-${lang}`}
            placeholder={t.waitlist.phonePlaceholder}
          />
          <p id={`wl-phone-err-${lang}`} class="field-err" aria-live="polite"></p>
          <label for={`wl-area-${lang}`}>{t.waitlist.area} <span class="opt">({t.waitlist.optional})</span></label>
          <input id={`wl-area-${lang}`} name="area" type="text" autocomplete="address-level3" placeholder={t.waitlist.areaPlaceholder} />
          <fieldset>
            <legend>{t.waitlist.role}</legend>
            <div class="chips">
              <label><input type="radio" name="role" value="ride" checked /><span><Icon name="pin" size={16} stroke={2} />{t.waitlist.roles.ride}</span></label>
              <label><input type="radio" name="role" value="send" /><span><Icon name="package" size={16} stroke={2} />{t.waitlist.roles.send}</span></label>
              <label><input type="radio" name="role" value="drive" /><span><Icon name="wheel" size={16} stroke={2} />{t.waitlist.roles.drive}</span></label>
            </div>
          </fieldset>
          <input type="hidden" name="lang" value={lang} />
          {/* Left empty by people (it is off screen); bots fill it in. */}
          <div class="trap" aria-hidden="true">
            <label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
          </div>
          {turnstileKey && <div class="turnstile" data-sitekey={turnstileKey} data-appearance="interaction-only" data-size="flexible" />}
          <button class="btn btn-gold" type="submit">{t.waitlist.submit}</button>
          <p class="fine">{t.waitlist.privacy}</p>
          <p class="status-msg" role="status" aria-live="polite"></p>
          </div>
          <div class="done" hidden>
            <span class="done-tick" aria-hidden="true"><Icon name="check" size={28} stroke={2.5} /></span>
            <h3 class="done-title" tabindex="-1" data-new={t.waitlist.successTitle} data-old={t.waitlist.alreadyTitle}></h3>
            <p class="done-body" data-new={t.waitlist.success} data-old={t.waitlist.already}></p>
            <button type="button" class="text-link done-again">{t.waitlist.another}</button>
          </div>
        </form>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap">
      <div class="foot-top">
        <p class="foot-tag">{t.footer.tagline}</p>
        <nav class="foot-nav" aria-label={t.nav.footerLabel}>
          <a href="#ride">{t.nav.ride}</a>
          <a href="#delivery">{t.nav.delivery}</a>
          <a href="#earn">{t.nav.earn}</a>
          <a href="#faq">{t.nav.faq}</a>
          <a class="wa" href={waLink} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d={waGlyph} /></svg>{t.contact.footer}</a>
          <a href={t.nav.switchHref} hreflang={lang === "en" ? "ha" : "en"} lang={lang === "en" ? "ha" : "en"}>{t.nav.switchLabel}</a>
        </nav>
        <div class="areas">
          <span>{t.footer.areasTitle}</span>
          <p>{t.footer.areas.join(" · ")}</p>
        </div>
      </div>
      <div class="foot-mark"><Logo height={120} motion="scroll" /></div>
      <p class="rights">© {new Date().getFullYear()} {t.footer.rights}</p>
    </div>
  </footer>
</Base>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Things that animate as they come into view (blocks rising in, the footer
  // logo). Uses IntersectionObserver rather than CSS scroll timelines so it
  // runs the same in every browser, including iPhones and in-app browsers.
  if (!reduce) {
    document.documentElement.classList.add("motion-ok");
    const seen = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add("is-in");
          seen.unobserve(e.target);
        }),
      { rootMargin: "0px 0px -10% 0px" },
    );
    document.querySelectorAll(".reveal, [data-inview]").forEach((el) => seen.observe(el));
  }

  // Header turns solid once you scroll past the top.
  const top = document.querySelector<HTMLElement>("[data-top]");
  // It slides away while you scroll down to read, and comes back as soon as
  // you scroll up a little (or tab into it), so the waitlist button is
  // always one flick away without covering the page.
  const keyFocus = () => {
    try {
      return !!top?.querySelector(":focus-visible");
    } catch {
      return false; // Safari before 15.4 has no :focus-visible
    }
  };
  let lastY = scrollY;
  let queued = false;
  const update = () => {
    queued = false;
    if (!top) return;
    // Clamp the bounce past the top and bottom on iPhone, which otherwise
    // reads as a scroll the wrong way and flicks the bar in or out.
    const y = Math.min(Math.max(scrollY, 0), document.documentElement.scrollHeight - innerHeight);
    top.classList.toggle("solid", y > 8);
    if (y < 120 || keyFocus()) top.classList.remove("away");
    else if (y - lastY > 8) top.classList.add("away");
    else if (lastY - y > 8) top.classList.remove("away");
    else return;
    lastY = y;
  };
  const onScroll = () => {
    if (!queued) {
      queued = true;
      requestAnimationFrame(update);
    }
  };
  addEventListener("scroll", onScroll, { passive: true });
  // Only keyboard focus pins the bar; a tapped link keeps focus on phones and
  // would otherwise stop the bar from ever hiding again.
  top?.addEventListener("focusin", () => {
    if (keyFocus()) top.classList.remove("away");
  });
  update();

  // Hero: Ride and Delivery take turns. Each tab fills while it is showing;
  // when it is full the other one takes over. Tapping a tab picks it.
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (hero) {
    const btns = [...hero.querySelectorAll<HTMLButtonElement>("[data-mode-btn]")];
    const leads = [...hero.querySelectorAll<HTMLElement>("[data-lead]")];
    const set = (i: number) => {
      hero.dataset.mode = String(i);
      btns.forEach((b, k) => b.setAttribute("aria-pressed", String(k === i)));
      leads.forEach((l, k) => {
        l.classList.toggle("on", k === i);
        l.toggleAttribute("aria-hidden", k !== i);
      });
    };
    btns.forEach((b, i) =>
      b.addEventListener("click", () => {
        hero.classList.add("picked");
        set(i);
      }),
    );
    if (!reduce) {
      btns.forEach((b, i) =>
        b.querySelector(".fill")?.addEventListener("animationend", () => {
          if (!hero.classList.contains("picked")) set((i + 1) % btns.length);
        }),
      );
      // Pause the turn-taking while the hero is off screen, and while the
      // pointer rests on the tabs and line (so a line is never pulled away
      // mid-read). A tap or click picks a tab and stops the turn-taking for
      // good: the visitor has chosen, so the page stops choosing for them.
      let offscreen = false;
      let hovering = false;
      let focused = false;
      const sync = () => hero.classList.toggle("paused", offscreen || hovering || focused);
      const pick = hero.querySelector<HTMLElement>(".hero-pick");
      new IntersectionObserver((es) => {
        offscreen = !es[es.length - 1].isIntersecting;
        sync();
      }).observe(hero);
      // Keyboard users get the same courtesy as the mouse: while focus is on
      // the tabs or button, the line stays put.
      pick?.addEventListener("focusin", () => ((focused = true), sync()));
      pick?.addEventListener("focusout", (e) => {
        if (!pick.contains(e.relatedTarget as Node)) (focused = false), sync();
      });
      pick?.addEventListener("pointerenter", (e) => {
        if (e.pointerType === "mouse") (hovering = true), sync();
      });
      pick?.addEventListener("pointerleave", () => ((hovering = false), sync()));
    }
  }

  // Background videos. The page paints with the still frame first; a video
  // only starts downloading after the page has loaded and once it is near
  // the screen, then fades in over its still once it is actually playing.
  // AV1 where the device decodes it (sharper at half the size), H.264
  // elsewhere, with a lighter H.264 file for phones.
  // Each clip is cut to loop on itself, so there is no jump to hide. They
  // pause off screen and stay as stills when motion is off or data is saved.
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
  // Stills only when data saving is on or the network is 2G: the films are
  // extra. (Not 3G: browsers and in-app views report 3G for many ordinary
  // connections, which left the hero as a still.)
  const saveData = conn?.saveData || /(^|-)2g$/.test(conn?.effectiveType ?? "");
  const startVideos = () => {
    const av1 = document.createElement("video").canPlayType('video/mp4; codecs="av01.0.05M.10"') === "probably";
    const phone = matchMedia("(max-width: 720px)").matches;
    document.querySelectorAll<HTMLVideoElement>("video[data-mp4]").forEach((v) => {
      let loaded = false;
      v.addEventListener("playing", () => v.classList.add("on"), { once: true });
      new IntersectionObserver(
        (es) => {
          if (!es[es.length - 1].isIntersecting) return v.pause();
          if (!loaded) {
            loaded = true;
            const d = v.dataset;
            // Start on the frame the still shows, so the fade-in has no ghosting.
            v.src = ((av1 && d.av1) || (phone && d.mp4Small) || d.mp4!) + (d.start ? `#t=${d.start}` : "");
          }
          // Low Power Mode on iPhones refuses to start a film on its own;
          // the first tap anywhere starts it.
          v.play().catch(() => addEventListener("touchend", () => v.play().catch(() => {}), { once: true, passive: true }));
        },
        { rootMargin: "200px" },
      ).observe(v.parentElement!);
    });
  };
  if (!reduce && !saveData) {
    if (document.readyState === "complete") startVideos();
    else addEventListener("load", startVideos, { once: true });
  }

  // Ride: the phone plays the three steps in turn. Each step's bar fills
  // while it shows; tapping a step jumps to it. It only runs while the
  // section is on screen, and steps by tap only when motion is turned off.
  const how = document.querySelector<HTMLElement>("[data-steps]");
  const stepBtns = [...document.querySelectorAll<HTMLButtonElement>("[data-step-btn]")];
  if (how && stepBtns.length) {
    const show = (n: number) => {
      how.dataset.step = String(n);
      stepBtns.forEach((b, k) => b.setAttribute("aria-pressed", String(k + 1 === n)));
    };
    stepBtns.forEach((b, k) => {
      b.addEventListener("click", () => {
        how.classList.add("picked");
        show(k + 1);
      });
      b.querySelector(".step-timer")?.addEventListener("animationend", () => {
        if (!how.classList.contains("picked")) show((k + 1) % stepBtns.length + 1);
      });
    });
    // Runs while on screen; holds still while the pointer or keyboard focus
    // is on the steps, so a step is never pulled away mid-read.
    let inView = false;
    let held = false;
    const sync = () => {
      how.classList.toggle("running", inView && !reduce);
      how.classList.toggle("paused", held);
    };
    new IntersectionObserver((es) => ((inView = es[es.length - 1].isIntersecting), sync()), { threshold: 0.35 }).observe(how);
    const steps = how.querySelector<HTMLElement>(".steps");
    steps?.addEventListener("pointerenter", (e) => {
      if (e.pointerType === "mouse") (held = true), sync();
    });
    steps?.addEventListener("pointerleave", () => ((held = false), sync()));
    steps?.addEventListener("focusin", () => ((held = true), sync()));
    steps?.addEventListener("focusout", (e) => {
      if (!steps.contains(e.relatedTarget as Node)) (held = false), sync();
    });
  }

  // Buttons like "Register to drive" pre-select the matching option.
  document.querySelectorAll<HTMLAnchorElement>("a[data-role]").forEach((a) => {
    a.addEventListener("click", () => {
      const radio = document.querySelector<HTMLInputElement>(`input[name=role][value=${a.dataset.role}]`);
      if (radio) radio.checked = true;
    });
  });

  // Waitlist. Accepts Nigerian numbers however they are typed (0803 000 0000,
  // +234 803 000 0000, 2348030000000) and says plainly when one is not right.
  const form = document.querySelector<HTMLFormElement>("form.form");
  const phone = form?.querySelector<HTMLInputElement>("input[name=phone]");
  const phoneErr = form?.querySelector<HTMLElement>(".field-err");
  const clearPhone = () => {
    phone?.removeAttribute("aria-invalid");
    if (phoneErr) phoneErr.textContent = "";
  };
  phone?.addEventListener("input", clearPhone);
  // Turnstile's script loads only once someone starts on the form.
  const ts = form?.querySelector<HTMLElement>(".turnstile");
  if (form && ts) {
    form.addEventListener(
      "focusin",
      () => {
        (window as Window & { onTs?: () => void }).onTs = () => {
          (window as Window & { turnstile?: { render: (el: HTMLElement, o: object) => void } }).turnstile?.render(ts, { sitekey: ts.dataset.sitekey, appearance: "interaction-only", size: "flexible" });
        };
        const sc = document.createElement("script");
        sc.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onTs&render=explicit";
        sc.async = true;
        document.head.append(sc);
      },
      { once: true },
    );
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const status = form.querySelector<HTMLElement>(".status-msg")!;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const { endpoint, msgClosed, msgError, msgPhone, msgSlow } = form.dataset;
    const say = (msg: string, state = "") => {
      status.textContent = "";
      requestAnimationFrame(() => {
        status.textContent = msg;
        status.dataset.state = state;
      });
    };
    const digits = (phone?.value ?? "").replace(/[^\d+]/g, "");
    if (!/^(\+?234|0)?[789][01]\d{8}$/.test(digits)) {
      phone?.setAttribute("aria-invalid", "true");
      if (phoneErr) phoneErr.textContent = msgPhone ?? "";
      phone?.focus();
      return;
    }
    clearPhone();
    if (!endpoint) return say(msgClosed ?? "");
    button.disabled = true;
    say("");
    try {
      const data: Record<string, unknown> = Object.fromEntries(new FormData(form));
      data.phone = "+234" + digits.replace(/^(\+?234|0)/, "");
      data.token = data["cf-turnstile-response"];
      delete data["cf-turnstile-response"];
      const res = await fetch(endpoint, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(data),
      });
      // Not switched on yet (or no server behind the page, as in previews).
      if ([404, 405, 501, 503].includes(res.status)) return say(msgClosed ?? "");
      if (res.status === 429) return say(msgSlow ?? "", "error");
      if (!res.ok) throw new Error(String(res.status));
      const { status: kind } = (await res.json()) as { status?: string };
      done(kind === "existing" ? "old" : "new");
    } catch {
      say(msgError ?? "", "error");
      (window as Window & { turnstile?: { reset: () => void } }).turnstile?.reset();
    } finally {
      button.disabled = false;
    }
  });

  // The form turns into a confirmation in the same card: a tick, one line,
  // and a way to add a different number.
  const doneBox = form?.querySelector<HTMLElement>(".done");
  const done = (kind: "new" | "old") => {
    if (!form || !doneBox) return;
    const title = doneBox.querySelector<HTMLElement>(".done-title")!;
    const body = doneBox.querySelector<HTMLElement>(".done-body")!;
    title.textContent = title.dataset[kind] ?? "";
    body.textContent = body.dataset[kind] ?? "";
    form.classList.add("is-done");
    doneBox.hidden = false;
    title.focus({ preventScroll: true });
  };
  doneBox?.querySelector(".done-again")?.addEventListener("click", () => {
    if (!form) return;
    form.reset();
    form.classList.remove("is-done");
    doneBox.hidden = true;
    const status = form.querySelector<HTMLElement>(".status-msg");
    if (status) status.textContent = "";
    (window as Window & { turnstile?: { reset: () => void } }).turnstile?.reset();
    phone?.focus();
  });
</script>

<style>
  h1,
  h2,
