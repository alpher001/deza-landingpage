---
import Base from "../layouts/Base.astro";
import ArewaPattern from "./ArewaPattern.astro";
import PhoneMock from "./PhoneMock.astro";
import Photo from "./Photo.astro";
import Logo from "./Logo.astro";
import StoreBadges from "./StoreBadges.astro";
import Icon from "./Icon.astro";
import { copy, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const home = lang === "en" ? "/" : "/ha/";
// The waitlist endpoint is decided later. Until it is set, the form says
// sign-ups open soon instead of pretending to save anything.
const waitlistUrl = import.meta.env.PUBLIC_WAITLIST_URL ?? "";
---

<Base lang={lang} title={t.meta.title} description={t.meta.description}>
  <header class="top">
    <div class="wrap bar">
      <a class="brand" href={home} aria-label="Deza"><Logo height={24} /></a>
      <nav aria-label="Main">
        <a href="#services">{t.nav.services}</a>
        <a href="#how">{t.nav.how}</a>
        <a href="#drive">{t.nav.drive}</a>
        <a href="#app">{t.nav.app}</a>
      </nav>
      <div class="bar-end">
        <a class="lang" href={t.nav.switchHref} hreflang={lang === "en" ? "ha" : "en"}>{t.nav.switchLabel}</a>
        <a class="btn btn-gold btn-sm" href="#app">{t.nav.cta}</a>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero: the keke photo is the page's first impression -->
    <section class="hero">
      <Photo name="hero-keke" mobile="hero-keke-mobile" alt={t.hero.photoAlt} class="hero-photo" position="70% 50%" eager />
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <span class="kicker">{t.hero.eyebrow}</span>
        <h1>
          <span>{t.hero.title[0]}</span>
          <span>{t.hero.title[1]}</span>
          <span class="gold">{t.hero.title[2]}</span>
        </h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="hero-actions">
          <a class="btn btn-gold" href="#app">{t.hero.cta}<Icon name="arrow" size={18} stroke={2.25} /></a>
          <StoreBadges label={t.hero.soon} />
        </div>
      </div>
      <div class="ticker">
        <div class="wrap ticker-row">
          {
            t.hero.ticker.map(([name, state], i) => (
              <div class:list={["tick", { first: i === 0 }]}>
                <strong>{name}</strong>
                <span>{state}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Services: ride now, delivery next -->
    <section id="services" class="services">
      <div class="wrap">
        <div class="head">
          <span class="kicker">{t.services.kicker}</span>
          <h2>{t.services.title}</h2>
        </div>
        <div class="service-grid">
          {
            t.services.items.map((s, i) => (
              <article class:list={["service", { next: i === 1 }]}>
                <Photo name={s.photo} alt={s.photoAlt} class="service-photo" />
                <div class="service-body">
                  <div class="service-top">
                    <h3>{s.name}</h3>
                    <span class="status">{s.status}</span>
                  </div>
                  <p>{s.body}</p>
                  <ul class="ticks">
                    {s.points.map((p) => (
                      <li>
                        <Icon name="check" size={16} stroke={2.5} />
                        {p}
                      </li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Full-width city band -->
    <section class="band">
      <Photo name="city-band" alt={t.band.photoAlt} class="band-photo" />
      <div class="band-shade" aria-hidden="true"></div>
      <div class="wrap band-inner">
        <h2>{t.band.title}</h2>
        <p>{t.band.body}</p>
      </div>
    </section>

    <!-- How a ride works -->
    <section id="how" class="how">
      <ArewaPattern id="arewa-how" opacity={0.07} />
      <div class="wrap how-grid">
        <div class="how-copy">
          <span class="kicker">{t.how.kicker}</span>
          <h2>{t.how.title}</h2>
          <ol class="steps">
            {
              t.how.steps.map((step, i) => (
                <li>
                  <span class="num">{i + 1}</span>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="how-phone">
          <PhoneMock t={t.phone} />
        </div>
      </div>
    </section>

    <!-- Drivers -->
    <section id="drive" class="drive">
      <div class="wrap drive-grid">
        <Photo name="driver-portrait" alt={t.drive.photoAlt} class="drive-photo" />
        <div class="drive-copy">
          <span class="kicker">{t.drive.kicker}</span>
          <h2>{t.drive.title}</h2>
          <p class="body">{t.drive.body}</p>
          <ul class="ticks big">
            {
              t.drive.points.map((p) => (
                <li>
                  <Icon name="check" size={18} stroke={2.5} />
                  {p}
                </li>
              ))
            }
          </ul>
          <a class="btn btn-ink" href="#app" data-role="drive">{t.drive.cta}</a>
        </div>
      </div>
    </section>

    <!-- App coming soon + waitlist -->
    <section id="app" class="app">
      <ArewaPattern id="arewa-app" color="var(--ink)" opacity={0.08} />
      <div class="wrap app-grid">
        <div class="app-copy">
          <span class="kicker">{t.app.kicker}</span>
          <h2>{t.app.title}</h2>
          <p class="body">{t.app.body}</p>
          <StoreBadges label={t.hero.soon} tone="dark" />
        </div>
        <form
          class="form"
          data-endpoint={waitlistUrl}
          data-msg-success={t.waitlist.success}
          data-msg-closed={t.waitlist.notOpen}
          data-msg-error={t.waitlist.error}
        >
          <label for="wl-phone">{t.waitlist.phone}</label>
          <input
            id="wl-phone"
            name="phone"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            required
            pattern="[0-9+ ]{10,16}"
            placeholder={t.waitlist.phonePlaceholder}
          />
          <label for="wl-area">{t.waitlist.area}</label>
          <input id="wl-area" name="area" type="text" autocomplete="address-level3" placeholder={t.waitlist.areaPlaceholder} />
          <fieldset>
            <legend>{t.waitlist.role}</legend>
            <div class="chips">
              <label><input type="radio" name="role" value="ride" checked /><span>{t.waitlist.roles.ride}</span></label>
              <label><input type="radio" name="role" value="send" /><span>{t.waitlist.roles.send}</span></label>
              <label><input type="radio" name="role" value="drive" /><span>{t.waitlist.roles.drive}</span></label>
            </div>
          </fieldset>
          <input type="hidden" name="lang" value={lang} />
          <button class="btn btn-gold" type="submit">{t.waitlist.submit}</button>
          <p class="fine">{t.waitlist.privacy}</p>
          <p class="status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-row">
      <Logo height={20} />
      <span>{t.footer.tagline}</span>
      <span>© {new Date().getFullYear()} {t.footer.rights}</span>
    </div>
  </footer>
</Base>

<script>
  // Buttons like "Register as a rider" pre-select the matching option.
  document.querySelectorAll<HTMLAnchorElement>("a[data-role]").forEach((a) => {
    a.addEventListener("click", () => {
      const radio = document.querySelector<HTMLInputElement>(`input[name=role][value=${a.dataset.role}]`);
      if (radio) radio.checked = true;
    });
  });

  const form = document.querySelector<HTMLFormElement>("form.form");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const status = form.querySelector<HTMLElement>(".status")!;
    const button = form.querySelector<HTMLButtonElement>("button")!;
    const { endpoint, msgSuccess, msgClosed, msgError } = form.dataset;
    status.dataset.state = "";
    if (!endpoint) {
      status.textContent = msgClosed ?? "";
      return;
    }
    button.disabled = true;
    try {
      const res = await fetch(endpoint, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      if (!res.ok) throw new Error(String(res.status));
      status.textContent = msgSuccess ?? "";
      status.dataset.state = "ok";
      form.reset();
    } catch {
      status.textContent = msgError ?? "";
      status.dataset.state = "error";
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  h1,
  h2,
  h3 {
    font-family: var(--display);
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  /* Header: floats over the hero photo */
  .top {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    color: var(--paper);
    background: linear-gradient(to bottom, rgb(20 23 27 / 0.7), transparent);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--lg);
    height: 72px;
  }

  .brand {
    text-decoration: none;
    color: var(--paper);
  }

  nav {
    display: flex;
    gap: 28px;
    margin-inline: auto;
    font-size: 15px;
    font-weight: 500;
  }

  nav a,
  .lang {
    color: var(--paper-70);
    text-decoration: none;
    transition: color 150ms;
  }

  nav a:hover,
  .lang:hover {
    color: var(--paper);
  }

  .bar-end {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .lang {
    font-size: 14px;
    font-weight: 600;
    padding: 7px 13px;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1px var(--paper-12);
  }

  .btn-sm {
    min-height: 40px;
    padding: 0 16px;
    font-size: 14px;
    border-radius: 10px;
  }

  .btn-ink {
    background: var(--ink);
    color: var(--paper);
  }

  .btn-ink:hover {
    background: color-mix(in srgb, var(--ink) 85%, white);
  }

  .kicker {
    color: var(--gold);
  }

  /* Hero */
  .hero {
    position: relative;
    min-height: clamp(640px, 100svh, 960px);
    display: grid;
    grid-template-rows: 1fr auto;
    color: var(--paper);
    background: var(--ink);
    isolation: isolate;
  }

  .hero :global(.hero-photo) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(20 23 27 / 0.88) 0%, rgb(20 23 27 / 0.55) 42%, rgb(20 23 27 / 0) 70%),
      linear-gradient(0deg, rgb(20 23 27 / 0.85) 0%, rgb(20 23 27 / 0) 35%);
  }

  .hero-inner {
    align-self: end;
    display: grid;
    justify-items: start;
    gap: var(--lg);
    padding-top: 120px;
    padding-bottom: clamp(40px, 6vw, 72px);
  }

  .hero h1 {
    display: grid;
    font-size: clamp(44px, 7.4vw, 108px);
    line-height: 0.98;
    font-weight: 700;
    letter-spacing: -0.045em;
  }

  .hero h1 span:nth-child(2) {
    font-weight: 300;
  }

  .gold {
    color: var(--gold);
  }

  .lead {
    max-width: 40ch;
    font-size: clamp(17px, 1.6vw, 20px);
    color: var(--paper-70);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .ticker {
    border-top: 1px solid var(--paper-12);
    background: rgb(20 23 27 / 0.55);
    backdrop-filter: blur(8px);
  }

  .ticker-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .tick {
    display: grid;
    gap: 2px;
    padding: 18px 0 18px 24px;
    border-left: 1px solid var(--paper-12);
  }

  .tick.first {
    padding-left: 0;
    border-left: 0;
  }

  .tick strong {
    font-family: var(--display);
    font-weight: 600;
    font-size: 15px;
  }

  .tick span {
    font-size: 13px;
    color: var(--paper-55);
  }

  .tick.first span {
    color: var(--gold);
  }

  /* Shared */
  .head {
    display: grid;
    gap: var(--md);
    max-width: 820px;
  }

  h2 {
    font-size: clamp(32px, 4.6vw, 60px);
    line-height: 1.02;
  }

  .body {
    font-size: 18px;
    max-width: 46ch;
  }

  .ticks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  .ticks li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 15px;
  }

  .ticks.big li {
    font-size: 17px;
  }

  /* Services */
  .services {
    padding-block: clamp(80px, 11vw, 150px);
  }

  .services .kicker {
    color: var(--ink);
  }

  .service-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--lg);
    margin-top: var(--xxl);
    align-items: start;
  }

  .service {
    display: grid;
    gap: var(--lg);
    min-width: 0;
  }

  .service.next {
    margin-top: clamp(0px, 8vw, 120px);
  }

  .service :global(.service-photo) {
    aspect-ratio: 4 / 5;
    border-radius: var(--r-lg);
  }

  .service-body {
    display: grid;
    gap: 14px;
    padding-right: var(--lg);
  }

  .service-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .service h3 {
    font-size: clamp(24px, 2.4vw, 32px);
  }

  .status {
    padding: 5px 12px;
    border-radius: var(--r-pill);
    background: var(--gold);
    font-size: 13px;
    font-weight: 700;
  }

  .next .status {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }

  .service p {
    color: var(--ink-70);
    max-width: 44ch;
  }

  .ticks :global(svg) {
    color: var(--ink);
    flex: none;
  }

  /* City band */
  .band {
    position: relative;
    min-height: clamp(420px, 52vw, 680px);
    display: grid;
    align-items: end;
    color: var(--paper);
    isolation: isolate;
  }

  .band :global(.band-photo) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .band-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgb(20 23 27 / 0.9) 0%, rgb(20 23 27 / 0.2) 60%, rgb(20 23 27 / 0) 100%);
  }

  .band-inner {
    display: grid;
    gap: var(--md);
    padding-block: clamp(48px, 7vw, 96px);
  }

  .band h2 {
    font-size: clamp(36px, 6.4vw, 92px);
    font-weight: 700;
    max-width: 14ch;
  }

  .band p {
    max-width: 48ch;
    font-size: 18px;
    color: var(--paper-70);
  }

  /* How */
  .how {
    position: relative;
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
    padding-block: clamp(80px, 11vw, 150px);
  }

  .how-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--xxl);
    align-items: center;
  }

  .how-copy {
    display: grid;
    gap: var(--md);
    min-width: 0;
  }

  .steps {
    list-style: none;
    margin: var(--lg) 0 0;
    padding: 0;
    display: grid;
  }

  .steps li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--md);
    padding-block: var(--lg);
    border-top: 1px solid var(--paper-12);
  }

  .num {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--gold);
    color: var(--ink);
    font-family: var(--display);
    font-weight: 700;
  }

  .steps h3 {
    font-size: 20px;
    margin-bottom: 6px;
  }

  .steps p {
    color: var(--paper-70);
  }

  .how-phone {
    display: flex;
    justify-content: center;
  }

  /* Drive */
  .drive {
    padding-block: clamp(80px, 11vw, 150px);
  }

  .drive .kicker {
    color: var(--ink);
  }

  .drive-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .drive :global(.drive-photo) {
    aspect-ratio: 4 / 5;
    border-radius: var(--r-lg);
  }

  .drive-copy {
    display: grid;
    gap: var(--lg);
    justify-items: start;
    min-width: 0;
  }

  .drive h2 {
    font-size: clamp(40px, 6vw, 84px);
    font-weight: 700;
  }

  .drive .body {
    color: var(--ink-70);
  }

  /* App + waitlist: the one gold surface on the page */
  .app {
    position: relative;
    overflow: hidden;
    background: var(--gold);
    color: var(--ink);
    padding-block: clamp(80px, 10vw, 136px);
  }

  .app .kicker {
    color: var(--ink);
  }

  .app-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--xxl);
    align-items: center;
  }

  .app-copy {
    display: grid;
    gap: var(--lg);
    justify-items: start;
    min-width: 0;
  }

  .app h2 {
    font-size: clamp(38px, 5.6vw, 76px);
    font-weight: 700;
  }

  .app .body {
    color: var(--ink-70);
  }

  .form {
    display: grid;
    gap: 10px;
    padding: var(--xl);
    border-radius: var(--r-lg);
    background: var(--ink);
    color: var(--paper);
    box-shadow: 0 40px 80px -40px rgb(30 35 41 / 0.6);
  }

  .form > label,
  legend {
    font-size: 14px;
    font-weight: 600;
    color: var(--paper-70);
  }

  .form input[type="tel"],
  .form input[type="text"] {
    width: 100%;
    height: 54px;
    margin-bottom: 10px;
    padding: 0 var(--md);
    border-radius: var(--r-md);
    border: 1.5px solid var(--paper-12);
    background: var(--paper-6);
    font: 500 17px var(--font);
    color: var(--paper);
  }

  .form input::placeholder {
    color: var(--paper-55);
  }

  .form input:focus {
    outline: none;
    border-color: var(--gold);
  }

  fieldset {
    border: 0;
    margin: 0 0 var(--sm);
    padding: 0;
  }

  legend {
    margin-bottom: var(--sm);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sm);
  }

  .chips input {
    position: absolute;
    opacity: 0;
  }

  .chips span {
    display: inline-block;
    padding: 10px 18px;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1.5px var(--paper-12);
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
  }

  .chips input:checked + span {
    background: var(--paper);
    color: var(--ink);
    box-shadow: none;
  }

  .chips input:focus-visible + span {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
  }

  .form button {
    width: 100%;
  }

  .form button:disabled {
    opacity: 0.6;
  }

  .fine {
    font-size: 13px;
    color: var(--paper-55);
  }

  .status:empty {
    display: none;
  }

  .status {
    padding: 12px var(--md);
    border-radius: var(--r-md);
    background: var(--paper-12);
    font-weight: 600;
    font-size: 15px;
  }

  .status[data-state="ok"] {
    background: var(--gold);
    color: var(--ink);
  }

  /* Footer */
  .foot {
    background: var(--ink);
    color: var(--paper-55);
    font-size: 14px;
  }

  .foot :global(.logo-text) {
    color: var(--paper);
  }

  .foot-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--md);
    padding-block: var(--xl);
  }

  /* Tablet */
  @media (max-width: 980px) {
    nav {
      display: none;
    }

    .bar-end {
      margin-left: auto;
    }

    .how-grid,
    .drive-grid,
    .app-grid {
      grid-template-columns: 1fr;
    }

    .drive :global(.drive-photo) {
      max-width: 520px;
      width: 100%;
    }
  }

  /* Phone */
  @media (max-width: 720px) {
    .bar-end .btn-sm {
      display: none;
    }

    .hero-shade {
      background: linear-gradient(0deg, rgb(20 23 27 / 0.92) 0%, rgb(20 23 27 / 0.6) 45%, rgb(20 23 27 / 0.15) 75%);
    }

    .hero-actions .btn {
      width: 100%;
    }

    .ticker-row {
      grid-template-columns: 1fr;
    }

    .tick,
    .tick.first {
      grid-template-columns: 1fr auto;
      align-items: baseline;
      padding: 12px 0;
      border-left: 0;
    }

    .tick + .tick {
      border-top: 1px solid var(--paper-12);
    }

    .service-grid {
      grid-template-columns: 1fr;
      gap: var(--xxl);
    }

    .service.next {
      margin-top: 0;
    }

    .service-body {
      padding-right: 0;
    }

    .steps li {
      grid-template-columns: 44px 1fr;
    }

    .form {
      padding: var(--lg);
    }
  }
</style>
