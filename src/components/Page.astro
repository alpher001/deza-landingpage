  }

  .phone-zoom,
  .phone-shot :global(.phone-photo) {
    position: absolute;
    inset: 0;
  }

  /* Matches the black screen in phone-in-hand.webp */
  .screen-slot {
    position: absolute;
    left: 31.6%;
    top: 23.1%;
    width: 36.8%;
    height: 64.6%;
  }

  .trust {
    list-style: none;
    margin-block: clamp(56px, 7vw, 96px) 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--lg);
  }

  .trust li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 14px;
    padding-top: var(--lg);
    border-top: 1px solid var(--paper-12);
  }

  .trust :global(svg) {
    color: var(--gold);
    margin-top: 2px;
  }

  .trust h3 {
    font-family: var(--font);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 4px;
  }

  .trust p {
    color: var(--paper-70);
    font-size: 15px;
  }

  /* Deza Delivery */
  .delivery {
    padding-block: clamp(80px, 9vw, 128px);
    overflow: hidden;
  }

  .chip-ink {
    background: var(--ink);
    color: var(--paper);
  }

  .head .chip {
    justify-self: start;
  }

  .delivery h2 {
    font-size: clamp(30px, 3.6vw, 52px);
  }

  .delivery .body {
    color: var(--ink-70);
  }

  .d-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .d-copy {
    display: grid;
    gap: var(--xl);
    min-width: 0;
  }

  .d-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }

  .d-steps li {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 14px;
  }

  .d-num {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--gold);
    font-family: var(--display);
    font-weight: 700;
    font-size: 14px;
  }

  .d-steps h3 {
    font-family: var(--font);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 2px;
  }

  .d-steps p {
    color: var(--ink-70);
    font-size: 15px;
  }

  .sends {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .sends li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 13px;
    border-radius: var(--r-pill);
    background: var(--ink-6);
    font-size: 14px;
    font-weight: 600;
  }

  .d-visual {
    position: relative;
    padding-bottom: 30%;
    min-width: 0;
  }

  .d-visual :global(.d-photo) {
    aspect-ratio: 4 / 5;
    width: 80%;
    border-radius: var(--r-lg);
  }

  /* A phone drawn in CSS, holding the live delivery screen. */
  .device {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 36%;
    aspect-ratio: 9 / 19.2;
    padding: 2.2%;
    border-radius: 15% / 7%;
    background: #0d0f12;
    box-shadow:
      inset 0 0 0 1.5px #3a3f46,
      0 40px 80px -24px rgb(var(--ink-rgb) / 0.55),
      0 12px 24px -12px rgb(var(--ink-rgb) / 0.4);
  }

  .device::before,
  .device::after {
    content: "";
    position: absolute;
    right: -1.6%;
    width: 1.6%;
    border-radius: 0 3px 3px 0;
    background: #2a2e34;
  }

  .device::before {
    top: 22%;
    height: 11%;
  }

  .device::after {
    top: 36%;
    height: 7%;
  }

  .device-screen {
    position: relative;
    height: 100%;
    border-radius: 13% / 6%;
    overflow: hidden;
  }

  .device-screen :global(.scr) {
    border-radius: inherit;
  }

  .biz {
    display: grid;
    gap: 20px;
    justify-items: start;
    margin-top: clamp(48px, 6vw, 80px);
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--r-lg);
    background: var(--ink);
    color: var(--paper);
  }

  .biz-copy {
    display: grid;
    gap: 8px;
  }

  .biz h3 {
    font-size: 20px;
  }

  .biz p {
    color: var(--paper-70);
    font-size: 15px;
    max-width: 56ch;
  }

  /* Wider screens: the question and answer on the left, the button on the right. */
  @media (min-width: 900px) {
    .biz {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 48px;
      padding: 40px 48px;
    }

    .biz h3 {
      font-size: clamp(22px, 2.2vw, 30px);
    }

    .biz p {
      font-size: 16px;
    }
  }

  @media (max-width: 720px) {
    .biz .btn,
    .earn-cta {
      width: 100%;
    }
  }

  .earn-cta {
    margin-top: 8px;
    justify-self: start;
  }

  /* Earn */
  .earn {
    padding-block: clamp(40px, 5vw, 72px) clamp(88px, 11vw, 160px);
  }

  /* The keke and rider band above does the picture work; this is the pitch:
     the headline on the left, the detail on the right. */
  .earn-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 6vw, 96px);
    align-items: start;
  }

  .earn-copy {
    display: grid;
    gap: var(--lg);
    justify-items: start;
    min-width: 0;
  }

  .earn h2 .line {
    display: block;
  }

  .earn .body {
    color: var(--ink-70);
  }

  .ticks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .ticks li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
    font-size: 17px;
  }

  /* Questions */
  .faq {
    padding-bottom: clamp(88px, 11vw, 160px);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .qs {
    border-top: 1px solid var(--ink-10);
  }

  details {
    border-bottom: 1px solid var(--ink-10);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--md);
    padding: 22px 0;
    font-weight: 650;
    font-size: 18px;
    text-wrap: balance;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary i {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--ink-6);
    transition:
      background-color 200ms ease,
      transform 300ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (hover: hover) {
    summary:hover i {
      background: var(--gold);
    }
  }

  summary:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
    border-radius: 4px;
  }

  summary i::before,
  summary i::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    margin: -1px 0 0 -6px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 250ms;
  }

  summary i::after {
    transform: rotate(90deg);
  }

  details[open] summary i::after {
    transform: rotate(0);
  }

  details p {
    padding-bottom: 22px;
    max-width: 60ch;
    color: var(--ink-70);
  }

  .ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    padding-top: 28px;
    color: var(--ink-70);
  }

  .ask a {
    color: var(--ink);
  }

  /* Join */
  .join {
    position: relative;
    color: var(--paper);
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(88px, 11vw, 160px);
  }

  .join-media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .join-media :global(.join-photo) {
    position: absolute;
    inset: 0;
  }

  /* Same framing as the still, so the fade from still to film never shifts. */
  .join-media .bg-video {
    object-position: 50% 85%;
  }

  .join-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(var(--ink-rgb) / 0.92) 0%, rgb(var(--ink-rgb) / 0.75) 45%, rgb(var(--ink-rgb) / 0.35) 100%);
  }

  .join-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--xxl);
    align-items: center;
  }

  .join-copy {
    display: grid;
    gap: var(--lg);
    justify-items: start;
    min-width: 0;
  }

  .join h2 {
    font-size: clamp(36px, 4.8vw, 66px);
    font-weight: 700;
  }

  .join .body {
    color: var(--paper-70);
  }

  .form {
    display: grid;
    gap: 10px;
    padding: var(--xl);
    border-radius: var(--r-lg);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.6);
  }

  .form > label,
  legend {
    font-size: 14px;
    font-weight: 600;
  }

  .form input[type="tel"],
  .form input[type="text"] {
    width: 100%;
    height: 54px;
    margin-bottom: 10px;
    padding: 0 var(--md);
    border-radius: var(--r-md);
    border: 1.5px solid var(--ink-55);
    background: #fff;
    font: 500 17px var(--font);
    color: var(--ink);
  }

  .form input:focus {
    outline: none;
    border-color: var(--ink);
    box-shadow: 0 0 0 1px var(--ink);
  }

  fieldset {
    border: 0;
    margin: 0 0 var(--sm);
    padding: 0;
  }

  legend {
    margin-bottom: var(--sm);
    padding: 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sm);
  }

  .chips input {
    position: absolute;
    opacity: 0;
  }

  .chips span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 16px;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1.5px var(--ink-10);
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      box-shadow 200ms ease;
  }

  @media (hover: hover) {
    .chips input:not(:checked) + span:hover {
      box-shadow: inset 0 0 0 1.5px rgb(var(--ink-rgb) / 0.3);
    }
  }

  .chips input:checked + span {
    background: var(--ink);
    color: var(--paper);
    box-shadow: none;
  }

  .chips input:focus-visible + span {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  .form button {
    width: 100%;
  }

  .form button:disabled {
    opacity: 0.6;
  }

  .fields {
    display: contents;
  }

  .form.is-done .fields {
    display: none;
  }

  .opt {
    color: var(--ink-70);
    font-weight: 500;
  }

  /* Off screen, not display:none, so simple bots still see and fill it. */
  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .turnstile:empty {
    display: none;
  }

  .done {
    display: grid;
    justify-items: start;
    gap: 12px;
    padding-block: 8px;
  }

  .done[hidden] {
    display: none;
  }

  .done-tick {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--gold);
    color: var(--ink);
  }

  .motion-ok .done:not([hidden]) .done-tick {
    animation: tick-in 420ms cubic-bezier(0.2, 0.7, 0.2, 1.2) both;
  }

  @keyframes tick-in {
    from {
      transform: scale(0.6);
      opacity: 0;
    }
  }

  .done-title {
    font-size: clamp(24px, 3vw, 32px);
    outline: none;
  }

  .done-body {
    color: var(--ink-70);
  }

  .done-again {
    margin-top: 4px;
    background: none;
    border: 0;
    padding-inline: 0;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .fine {
    font-size: 13px;
    color: var(--ink-70);
  }

  .status-msg:empty {
    padding: 0;
    background: none;
  }

  .field-err {
    margin-top: -4px;
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
  }

  .field-err:empty {
    display: none;
  }

  input[aria-invalid="true"] {
    border-color: var(--ink);
    box-shadow: 0 0 0 1px var(--ink);
  }

  .status-msg {
    padding: 12px var(--md);
    border-radius: var(--r-md);
    background: var(--ink-6);
    font-weight: 600;
    font-size: 15px;
  }

  .status-msg[data-state="ok"] {
    background: var(--gold);
  }

  /* Footer */
  .foot {
    background: var(--ink);
    color: var(--paper-55);
    font-size: 15px;
    overflow: hidden;
  }

  .foot-top {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--lg) var(--xxl);
    padding-top: clamp(56px, 7vw, 88px);
    border-top: 1px solid var(--paper-12);
  }

  .foot-tag {
    font-family: var(--display);
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--paper);
    max-width: 22ch;
  }

  .foot-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin: 0;
    align-self: start;
  }

  .areas {
    grid-column: 1 / -1;
    display: grid;
    gap: 6px;
    font-size: 14px;
  }

  .areas span {
    color: var(--paper);
    font-weight: 600;
  }

  .foot-mark {
    container-type: inline-size;
    color: var(--paper);
    padding-block: clamp(40px, 7vw, 88px) clamp(24px, 4vw, 40px);
  }

  .foot-mark :global(.logo) {
    --h: min(186px, 100cqw / 6.95) !important;
  }

  .rights {
    padding-bottom: var(--xl);
    font-size: 13px;
  }

  /* Tablet */
  @media (max-width: 980px) {
    nav:not(.foot-nav) {
      display: none;
    }

    .bar-end {
      margin-left: auto;
    }

    .earn-grid,
    .join-grid,
    .d-grid,
    .faq-grid,
    .trust {
      grid-template-columns: 1fr;
    }

    .d-visual {
      max-width: 620px;
    }
  }

  /* Phone */
  @media (max-width: 720px) {
    .top-bar {
      height: 60px;
      gap: var(--md);
    }

    .btn-sm {
      min-height: 36px;
      padding: 0 12px;
      font-size: 13px;
    }

    .lang {
      padding: 7px 11px;
      font-size: 13px;
    }

    .hero-inner {
      gap: 18px;
      padding-bottom: 28px;
    }

    .eyebrow {
      font-size: 12px;
    }

    .modes button {
      min-height: 44px;
      padding: 0 16px;
      font-size: 14px;
    }

    .lead {
      font-size: 16px;
    }

    /* Phones: the film fills the top of the screen like on desktop, with
       the headline over its sky, then melts into ink under the riders where
       the tabs and button sit. */
    .hero.has-video {
      --film: min(136vw, 74svh);
      min-height: 0;
      max-height: none;
      display: flex;
      flex-direction: column;
    }

    /* The film starts under the header, so it shows wide enough for both
       riders; its sky rises behind the headline and fades into the ink. */
    .has-video .hero-media {
      position: absolute;
      inset: 120px 0 auto;
      height: calc(var(--film) - 120px);
      z-index: -2;
      -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 26%, #000 78%, transparent 100%);
      mask-image: linear-gradient(180deg, transparent 0, #000 26%, #000 78%, transparent 100%);
    }

    /* The phone crop is narrower: frame it on the keke and the dispatch rider. */
    .has-video .hero-media :global(.hero-poster img),
    .has-video .hero-media .bg-video {
      object-position: 74% 50% !important;
    }

    /* Ink behind the header and headline, clear over the riders. */
    .has-video .hero-shade {
      display: block;
      inset: 120px 0 auto;
      height: calc(var(--film) - 120px);
      background: linear-gradient(180deg, rgb(var(--ink-rgb) / 0.5) 0%, rgb(var(--ink-rgb) / 0.25) 30%, rgb(var(--ink-rgb) / 0) 48%);
    }

    .has-video .hero-inner {
      display: contents;
    }

    .has-video h1,
    .has-video .hero-pick {
      padding-inline: var(--gutter);
    }

    .has-video h1 {
      order: 1;
      box-sizing: border-box;
      min-height: calc(var(--film) - 40px);
      padding-top: 88px;
      align-content: start;
    }

    .has-video .hero-pick {
      order: 3;
      position: relative;
      justify-items: stretch;
    }

    .has-video .hero-pick .modes {
      justify-self: start;
    }

    .has-video .hero-pick {
      padding-bottom: 24px;
    }

    .hero-actions {
      display: grid;
      gap: 28px;
    }

    .has-video .title {
      font-size: clamp(44px, 13vw, 60px);
    }

    .hero-cta {
      width: 100%;
    }

    /* Ride: phone first, the steps right under it. */
    .how-grid {
      grid-template-columns: 1fr;
      gap: var(--lg);
    }

    .how-copy {
      display: contents;
    }

    .how-copy .head {
      order: 1;
    }

    /* Phones: the phone, then right under it the three step tracks (tap
       one to jump) with the open step's words below them. Number, words
       and screen read as one block and fit on one screen together. */
    .how-visual {
      display: contents;
    }

    .phone-shot {
      order: 2;
    }

    .steps {
      order: 3;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-top: -4px;
    }

    .steps button,
    .steps button[aria-pressed="true"] {
      display: block;
      height: 36px;
      padding: 0;
      border-radius: 0;
      background: transparent;
    }

    .steps .num {
      width: auto;
      height: auto;
      display: block;
      background: none;
      box-shadow: none;
      color: var(--paper-55);
      font-size: 12px;
      text-align: left;
    }

    .steps [aria-pressed="true"] .num {
      background: none;
      color: var(--paper);
    }

    .steps .step-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .steps button::before,
    .step-timer {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 6px;
      height: 3px;
      border-radius: 2px;
    }

    .steps button::before {
      background: var(--paper-12);
    }

    /* Steps already seen stay full; a tapped step shows full too. */
    .how[data-step="2"] .steps li:nth-child(1) .step-timer,
    .how[data-step="3"] .steps li:nth-child(-n + 2) .step-timer,
    .how.picked [aria-pressed="true"] .step-timer,
    .how:not(.running) [aria-pressed="true"] .step-timer {
      opacity: 1;
      transform: none;
    }

    .step-captions {
      order: 4;
      display: grid;
      margin-top: -10px;
    }

    .step-captions p {
      grid-area: 1 / 1;
      display: grid;
      gap: 6px;
      color: var(--paper-70);
      font-size: 16px;
      opacity: 0;
      transition: opacity 200ms ease;
    }

    .step-captions b {
      font-family: var(--display);
      font-weight: 600;
      font-size: 20px;
      letter-spacing: -0.03em;
      color: var(--paper);
    }

    .how[data-step="1"] [data-cap="1"],
    .how[data-step="2"] [data-cap="2"],
    .how[data-step="3"] [data-cap="3"] {
      opacity: 1;
      transition: opacity 320ms ease 120ms;
    }

    /* Crop in on the phone so the app screen is big enough to read. */
    .phone-shot {
      --ph: min(50svh, 420px);
      width: 100%;
      height: var(--ph);
      aspect-ratio: auto;
      max-width: 420px;
      margin-inline: auto;
    }

    .phone-zoom {
      inset: auto;
      left: 50%;
      top: 50%;
      width: calc(var(--ph) * 1.12);
      aspect-ratio: 1000 / 1252;
      transform: translate(-50%, -55.5%);
    }

    .trust {
      gap: 0;
    }

    .trust li {
      padding-block: 18px;
    }

    .d-visual {
      order: -1;
    }

    .d-grid {
      gap: var(--xl);
    }

    .d-copy {
      display: contents;
    }

    .d-copy .head {
      order: -2;
    }

    .d-visual {
      padding-bottom: 34%;
    }

    .d-visual :global(.d-photo) {
      width: 100%;
    }

    .device {
      width: 38%;
      right: 12px;
    }

    .sends li {
      padding: 7px 12px;
      font-size: 13px;
    }

    .chips {
      display: grid;
    }

    .chips span {
      display: flex;
      min-height: 52px;
