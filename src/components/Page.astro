---
import fs from "node:fs";
import path from "node:path";
import Base from "../layouts/Base.astro";
import Photo from "./Photo.astro";
import Logo from "./Logo.astro";
import StoreBadges from "./StoreBadges.astro";
import ScreenUI from "./ScreenUI.astro";
import KanoMapDefs from "./KanoMapDefs.astro";
import Cruise from "./Cruise.astro";
import Icon from "./Icon.astro";
import { copy, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const home = lang === "en" ? "/" : "/ha/";
// The waitlist endpoint is decided later. Until it is set, the form says
// sign-ups open soon instead of pretending to save anything.
const waitlistUrl = import.meta.env.PUBLIC_WAITLIST_URL ?? "";

const has = (p: string) => fs.existsSync(path.join(process.cwd(), "public", p));
const firstOf = (...names: string[]) => names.find((n) => ["webp", "jpg", "jpeg", "png"].some((e) => has(`images/${n}.${e}`)));
const stillOf = (n: string) => ["webp", "jpg"].map((e) => `/images/${n}.${e}`).find((p) => has(p.slice(1)));

// Hero: a video when one is in public/video/, otherwise the two photos.
const heroVideo = has("video/hero.mp4") ? "/video/hero.mp4" : null;
const heroVideoMobile = has("video/hero-mobile.mp4") ? "/video/hero-mobile.mp4" : null;
const heroPoster = stillOf("hero-still") ?? "/images/hero-keke.webp";
const courierPhoto = firstOf("courier-city", "delivery-hand")!;
const doorstepPhoto = firstOf("courier-doorstep", "delivery-hand")!;
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} ogAlt={t.meta.ogAlt} faq={t.faq.items}>
  <KanoMapDefs />

  <header class="top" data-top>
    <div class="wrap bar">
      <a class="brand" href={home} aria-label="Deza"><Logo height={19} motion="intro" /></a>
      <nav aria-label="Main">
        <a href="#ride">{t.nav.ride}</a>
        <a href="#delivery">{t.nav.delivery}</a>
        <a href="#safety">{t.nav.safety}</a>
        <a href="#earn">{t.nav.earn}</a>
      </nav>
      <div class="bar-end">
        <a class="lang" href={t.nav.switchHref} hreflang={lang === "en" ? "ha" : "en"} lang={lang === "en" ? "ha" : "en"}>{t.nav.switchLabel}</a>
        <a class="btn btn-gold btn-sm" href="#join">{t.nav.cta}</a>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero: rides and deliveries, switching on their own -->
    <section class:list={["hero", { "has-video": heroVideo }]} data-hero data-mode="0">
      <div class="hero-media">
        {
          heroVideo ? (
            <>
              <video class="hero-video" autoplay muted loop playsinline preload="auto" poster={heroPoster} aria-label={t.hero.rideAlt} data-hero-video>
                {heroVideoMobile && <source media="(max-width: 720px)" src={heroVideoMobile} type="video/mp4" />}
                <source src={heroVideo} type="video/mp4" />
              </video>
              <i class="loop-fade" aria-hidden="true" />
            </>
          ) : (
            <>
              <div class="layer l0">
                <Photo name="hero-keke" mobile="hero-keke-mobile" alt={t.hero.rideAlt} class="hero-photo" position="68% 50%" eager />
              </div>
              <div class="layer l1">
                <Photo name={courierPhoto} alt={t.hero.deliveryAlt} class="hero-photo" position="50% 40%" />
              </div>
            </>
          )
        }
      </div>
      <div class="hero-shade" aria-hidden="true"></div>

      <div class="wrap hero-inner">
        <h1>
          <span class="eyebrow load" style="--d:0">{t.hero.eyebrow}</span>
          <span class="title">
            {t.hero.title.map((w, i) => (
              <span class="word-mask">
                <span class:list={["load-word", { gold: i === 2 }]} style={`--d:${i}`}>{w}</span>
              </span>
            ))}
          </span>
        </h1>

        <div class="hero-pick">
        <div class="modes load" style="--d:4" role="tablist" aria-label="Deza">
          {
            t.hero.modes.map((m, i) => (
              <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-mode-btn={i}>
                <Icon name={i === 0 ? "pin" : "package"} size={16} stroke={2} />
                {m.label}
                <i class="fill" aria-hidden="true" />
              </button>
            ))
          }
        </div>

        <div class="leads load" style="--d:5">
          {t.hero.modes.map((m, i) => <p class:list={["lead", { on: i === 0 }]} data-lead={i}>{m.lead}</p>)}
        </div>
        </div>

        <div class="hero-actions load" style="--d:6">
          <a class="btn btn-gold" href="#join">{t.hero.cta}<Icon name="arrow" size={18} stroke={2.25} /></a>
          <StoreBadges label={t.hero.soon} />
        </div>
      </div>
    </section>

    <!-- What Deza does: two products, equal weight -->
    <section class="intro">
      <div class="wrap">
        <p class="statement reveal">{t.intro.text}</p>
        <h2 class="sr-only">{t.lanes.label}</h2>
        <div class="lanes">
          {
            t.lanes.items.map((l, i) => (
              <a class="lane reveal" href={l.href} style={`--i:${i}`}>
                <Photo name={l.photo} alt={l.alt} class="lane-photo" position={i === 0 ? "50% 30%" : "68% 55%"} />
                <span class="lane-shade" aria-hidden="true" />
                <span class:list={["chip", { "chip-gold": i === 0 }]}>{l.status}</span>
                <span class="lane-copy">
                  <h3>{l.name}</h3>
                  <span class="lane-body">{l.body}</span>
                  <span class="lane-link">
                    {l.link}
                    <Icon name="arrow" size={16} stroke={2.25} />
                  </span>
                </span>
              </a>
            ))
          }
        </div>
        <p class="pay-line reveal">
          <Icon name="wallet" size={20} />
          {t.lanes.pay}
        </p>
      </div>
    </section>

    <!-- Deza Ride: sticky phone, screen follows the steps -->
    <section id="ride" class="how" data-steps data-step="1">
      <div class="wrap how-grid">
        <div class="how-copy">
          <div class="head">
            <span class="kicker">{t.how.kicker}</span>
            <h2>{t.how.title}</h2>
          </div>
          <ol class="steps">
            {
              t.how.steps.map((s, i) => (
                <li data-step-item={i + 1}>
                  <span class="num">{i + 1}</span>
                  <div>
                    <h3>{s.title}</h3>
                    <p>{s.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="how-visual">
          <div class="phone-shot">
            <div class="phone-zoom">
              <Photo name="phone-in-hand" alt={t.how.photoAlt} class="phone-photo" />
              <div class="screen-slot"><ScreenUI t={t.screen} /></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Deza Delivery -->
    <section id="delivery" class="delivery">
      <div class="wrap">
        <div class="head reveal">
          <span class="kicker dark">
            {t.delivery.kicker}
            <span class="chip chip-gold soon-chip">{t.delivery.status}</span>
          </span>
          <h2>{t.delivery.title}</h2>
          <p class="body">{t.delivery.body}</p>
        </div>

        <div class="d-grid">
          <div class="d-visual reveal">
            <Photo name={doorstepPhoto} alt={t.delivery.photoAlt} class="d-photo" position="50% 45%" />
            <div class="device">
              <div class="device-screen"><ScreenUI t={t.screen} mode="delivery" /></div>
            </div>
          </div>

          <div class="d-copy">
            <ol class="d-steps">
              {
                t.delivery.steps.map((s, i) => (
                  <li class="reveal" style={`--i:${i}`}>
                    <span class="d-num">0{i + 1}</span>
                    <div>
                      <h3>{s.title}</h3>
                      <p>{s.body}</p>
                    </div>
                  </li>
                ))
              }
            </ol>

            <div class="sends reveal">
              <h3>{t.delivery.sendsTitle}</h3>
              <ul>
                {t.delivery.sends.map((s, i) => (
                  <li>
                    <Icon name={(["doc", "bag", "store", "phone"] as const)[i]} size={18} />
                    {s}
                  </li>
                ))}
              </ul>
            </div>

            <div class="biz reveal">
              <h3>{t.delivery.bizTitle}</h3>
              <p>{t.delivery.bizBody}</p>
              <a class="btn btn-gold" href="#join" data-role="send">{t.delivery.cta}<Icon name="arrow" size={18} stroke={2.25} /></a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Cruise places={t.footer.areas} />

    <!-- Safety, at night -->
    <section id="safety" class="safety">
      <div class="parallax">
        <Photo name="night-ride" alt={t.safety.photoAlt} class="safety-photo" position="50% 60%" />
      </div>
      <div class="safety-shade" aria-hidden="true"></div>
      <div class="wrap safety-inner">
        <div class="head reveal">
          <span class="kicker">{t.safety.kicker}</span>
          <h2>{t.safety.title}</h2>
        </div>
        <ul class="safety-list">
          {
            t.safety.items.map((s, i) => (
              <li class="reveal" style={`--i:${i}`}>
                <Icon name={(["shield", "share", "tag"] as const)[i]} size={24} />
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Earn -->
    <section id="earn" class="earn">
      <div class="wrap earn-grid">
        <div class="earn-media reveal">
          <Photo name="driver-portrait" alt={t.earn.photoAlt} class="earn-photo" position="50% 35%" />
        </div>
        <div class="earn-copy reveal">
          <span class="kicker dark">{t.earn.kicker}</span>
          <h2>{t.earn.title}</h2>
          <p class="body">{t.earn.body}</p>
          <ul class="ticks">
            {
              t.earn.points.map((p) => (
                <li>
                  <Icon name="check" size={18} stroke={2.5} />
                  {p}
                </li>
              ))
            }
          </ul>
          <a class="btn btn-ink" href="#join" data-role="drive">{t.earn.cta}</a>
        </div>
      </div>
    </section>

    <!-- Questions -->
    <section id="faq" class="faq">
      <div class="wrap faq-grid">
        <div class="head">
          <span class="kicker dark">{t.faq.kicker}</span>
          <h2>{t.faq.title}</h2>
        </div>
        <div class="qs">
          {
            t.faq.items.map((f, i) => (
              <details open={i === 0}>
                <summary>
                  {f.q}
                  <i aria-hidden="true" />
                </summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Join -->
    <section id="join" class="join">
      <Photo name="hero-keke" mobile="hero-keke-mobile" alt="" class="join-photo" position="75% 50%" />
      <div class="join-shade" aria-hidden="true"></div>
      <div class="wrap join-grid">
        <div class="join-copy reveal">
          <span class="kicker">{t.app.kicker}</span>
          <h2>{t.app.title}</h2>
          <p class="body">{t.app.body}</p>
          <StoreBadges label={t.hero.soon} />
        </div>
        <form
          class="form reveal"
          data-endpoint={waitlistUrl}
          data-msg-success={t.waitlist.success}
          data-msg-closed={t.waitlist.notOpen}
          data-msg-error={t.waitlist.error}
        >
          <label for={`wl-phone-${lang}`}>{t.waitlist.phone}</label>
          <input
            id={`wl-phone-${lang}`}
            name="phone"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            required
            pattern="[0-9+ ]{10,16}"
            placeholder={t.waitlist.phonePlaceholder}
          />
          <label for={`wl-area-${lang}`}>{t.waitlist.area}</label>
          <input id={`wl-area-${lang}`} name="area" type="text" autocomplete="address-level3" placeholder={t.waitlist.areaPlaceholder} />
          <fieldset>
            <legend>{t.waitlist.role}</legend>
            <div class="chips">
              <label><input type="radio" name="role" value="ride" checked /><span>{t.waitlist.roles.ride}</span></label>
              <label><input type="radio" name="role" value="send" /><span>{t.waitlist.roles.send}</span></label>
              <label><input type="radio" name="role" value="drive" /><span>{t.waitlist.roles.drive}</span></label>
            </div>
          </fieldset>
          <input type="hidden" name="lang" value={lang} />
          <button class="btn btn-gold" type="submit">{t.waitlist.submit}</button>
          <p class="fine">{t.waitlist.privacy}</p>
          <p class="status-msg" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap">
      <div class="foot-top">
        <p class="foot-tag">{t.footer.tagline}</p>
        <nav class="foot-nav" aria-label="Footer">
          <a href="#ride">{t.nav.ride}</a>
          <a href="#delivery">{t.nav.delivery}</a>
          <a href="#earn">{t.nav.earn}</a>
          <a href="#faq">{t.nav.faq}</a>
          <a href={t.nav.switchHref} hreflang={lang === "en" ? "ha" : "en"}>{t.nav.switchLabel}</a>
        </nav>
        <div class="areas">
          <span>{t.footer.areasTitle}</span>
          <p>{t.footer.areas.join(" · ")}</p>
        </div>
      </div>
      <div class="foot-mark"><Logo height={120} motion="scroll" /></div>
      <p class="rights">© {new Date().getFullYear()} {t.footer.rights}</p>
    </div>
  </footer>
</Base>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Header turns solid once you scroll past the top.
  const top = document.querySelector<HTMLElement>("[data-top]");
  const onScroll = () => top?.classList.toggle("solid", scrollY > 40);
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Hero: Ride and Delivery take turns. Each tab fills while it is showing;
  // when it is full the other one takes over. Tapping a tab picks it.
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (hero) {
    const btns = [...hero.querySelectorAll<HTMLButtonElement>("[data-mode-btn]")];
    const leads = [...hero.querySelectorAll<HTMLElement>("[data-lead]")];
    const set = (i: number) => {
      hero.dataset.mode = String(i);
      btns.forEach((b, k) => b.setAttribute("aria-selected", String(k === i)));
      leads.forEach((l, k) => l.classList.toggle("on", k === i));
    };
    btns.forEach((b, i) =>
      b.addEventListener("click", () => {
        hero.classList.add("picked");
        set(i);
      }),
    );
    if (!reduce) {
      btns.forEach((b, i) =>
        b.querySelector(".fill")?.addEventListener("animationend", () => {
          if (!hero.classList.contains("picked")) set((i + 1) % btns.length);
        }),
      );
      // Pause the turn-taking while the hero is off screen.
      new IntersectionObserver(([e]) => hero.classList.toggle("paused", !e.isIntersecting)).observe(hero);
    }
  }

  // Hero video: a short fade hides the jump when the clip loops. It pauses
  // off screen, and does not play at all for people who turn motion off.
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  if (video && hero) {
    if (reduce) {
      video.removeAttribute("autoplay");
      video.pause();
    } else {
      video.addEventListener("timeupdate", () => {
        const left = video.duration - video.currentTime;
        hero.classList.toggle("fading", left < 0.55 || video.currentTime < 0.15);
      });
      new IntersectionObserver(([e]) => (e.isIntersecting ? video.play().catch(() => {}) : video.pause())).observe(hero);
    }
  }

  // Ride: the screen follows whichever step is in the middle of the screen.
  const how = document.querySelector<HTMLElement>("[data-steps]");
  const items = [...document.querySelectorAll<HTMLElement>("[data-step-item]")];
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting && how) {
          how.dataset.step = (e.target as HTMLElement).dataset.stepItem;
          items.forEach((it) => it.classList.toggle("active", it === e.target));
        }
      }
    },
    { rootMargin: "-45% 0px -45% 0px" },
  );
  items.forEach((it) => io.observe(it));
  items[0]?.classList.add("active");

  // Buttons like "Register to drive" pre-select the matching option.
  document.querySelectorAll<HTMLAnchorElement>("a[data-role]").forEach((a) => {
    a.addEventListener("click", () => {
      const radio = document.querySelector<HTMLInputElement>(`input[name=role][value=${a.dataset.role}]`);
      if (radio) radio.checked = true;
    });
  });

  const form = document.querySelector<HTMLFormElement>("form.form");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const status = form.querySelector<HTMLElement>(".status-msg")!;
    const button = form.querySelector<HTMLButtonElement>("button")!;
    const { endpoint, msgSuccess, msgClosed, msgError } = form.dataset;
    status.dataset.state = "";
    if (!endpoint) {
      status.textContent = msgClosed ?? "";
      return;
    }
    button.disabled = true;
    try {
      const res = await fetch(endpoint, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      if (!res.ok) throw new Error(String(res.status));
      status.textContent = msgSuccess ?? "";
      status.dataset.state = "ok";
      form.reset();
    } catch {
      status.textContent = msgError ?? "";
      status.dataset.state = "error";
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  h1,
  h2,
  h3 {
    font-family: var(--display);
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  h2 {
    font-size: clamp(30px, 4.6vw, 62px);
    line-height: 1.04;
  }

  .head {
    display: grid;
    gap: var(--md);
    max-width: 860px;
  }

  .kicker {
    color: var(--gold);
  }

  .kicker.dark {
    color: var(--ink);
  }

  .body {
    font-size: 18px;
    max-width: 48ch;
  }

  .btn-sm {
    white-space: nowrap;
    min-height: 40px;
    padding: 0 16px;
    font-size: 14px;
    border-radius: 10px;
  }

  .btn-ink {
    background: var(--ink);
    color: var(--paper);
  }

  .btn-ink:hover {
    background: color-mix(in srgb, var(--ink) 85%, white);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    border-radius: var(--r-pill);
    background: var(--paper);
    color: var(--ink);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .chip-gold {
    background: var(--gold);
  }

  /* Reveal on scroll. Resting state is fully visible; only browsers with
     scroll-driven animations get the rise-in. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .reveal {
        animation-name: rise;
        animation-fill-mode: both;
        animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
        animation-timeline: view();
        animation-range: entry calc(var(--i, 0) * 5%) entry calc(50% + var(--i, 0) * 5%);
      }
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
  }

  /* Header */
  .top {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    color: var(--paper);
    background: linear-gradient(to bottom, rgb(16 19 23 / 0.5), transparent);
    transition:
      background-color 250ms,
      box-shadow 250ms;
  }

  .top.solid {
    background: color-mix(in srgb, var(--ink) 94%, transparent);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--paper-6);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--lg);
    height: 68px;
  }

  .brand {
    color: var(--paper);
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 28px;
    margin-inline: auto;
    font-size: 15px;
    font-weight: 500;
  }

  nav a,
  .lang {
    color: var(--paper-70);
    text-decoration: none;
    transition: color 150ms;
  }

  nav a:hover,
  .lang:hover {
    color: var(--paper);
  }

  .bar-end {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .lang {
    font-size: 14px;
    font-weight: 600;
    padding: 8px 13px;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1px var(--paper-12);
  }

  /* Hero */
  .hero {
    position: relative;
    min-height: 100svh;
    max-height: 1100px;
    display: grid;
    align-items: end;
    color: var(--paper);
    background: var(--ink);
    overflow: hidden;
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.1s ease;
  }

  .layer :global(.hero-photo) {
    width: 100%;
    height: 100%;
  }

  [data-mode="0"] .l0,
  [data-mode="1"] .l1 {
    opacity: 1;
  }

  /* Each photo travels while it is on screen: the keke drifts in from the
     right, the courier from the left. */
  @media (prefers-reduced-motion: no-preference) {
    .layer :global(img) {
      transition: transform 7s cubic-bezier(0.25, 0.1, 0.25, 1);
      transform: scale(1.14) translateX(var(--from, 3%));
    }

    .l1 {
      --from: -3%;
    }

    [data-mode="0"] .l0 :global(img),
    [data-mode="1"] .l1 :global(img) {
      transform: scale(1.04) translateX(0);
    }
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(0deg, rgb(16 19 23 / 0.92) 0%, rgb(16 19 23 / 0.55) 38%, rgb(16 19 23 / 0) 68%),
      linear-gradient(90deg, rgb(16 19 23 / 0.55) 0%, transparent 55%);
  }

  .hero-inner {
    display: grid;
    justify-items: start;
    gap: 22px;
    padding-top: 120px;
    padding-bottom: clamp(40px, 6vw, 80px);
  }

  .hero h1 {
    display: grid;
    gap: 14px;
    margin: 0;
  }

  .eyebrow {
    font-family: var(--font);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper-70);
  }

  .title {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.26em;
    max-width: 12ch;
    font-size: clamp(50px, 9.4vw, 148px);
    line-height: 0.94;
    font-weight: 700;
    letter-spacing: -0.05em;
  }

  .word-mask {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .load-word {
    display: inline-block;
    animation: word 1s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(var(--d) * 110ms + 250ms);
  }

  @keyframes word {
    from {
      transform: translateY(105%);
    }
  }

  .gold {
    color: var(--gold);
  }

  .load {
    animation: up 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--d) * 90ms + 200ms);
  }

  @keyframes up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  .modes {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    border-radius: var(--r-pill);
    background: rgb(16 19 23 / 0.5);
    box-shadow: inset 0 0 0 1px var(--paper-12);
    backdrop-filter: blur(10px);
  }

  .modes button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 18px;
    border: 0;
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--paper-70);
    font: 700 15px/1 var(--font);
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    transition: color 250ms;
  }

  .modes button[aria-selected="true"] {
    color: var(--ink);
    background: var(--paper);
  }

  /* The fill is the timer: when it reaches the end, the other tab takes over. */
  .fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
  }

  @media (prefers-reduced-motion: no-preference) {
    .modes button[aria-selected="true"] .fill {
      animation: fill 6.5s linear forwards;
    }

    .hero.paused .modes .fill {
      animation-play-state: paused;
    }

    .hero.picked .modes .fill {
      animation: none;
      transform: scaleX(1);
      opacity: 0;
    }
  }

  @keyframes fill {
    to {
      transform: scaleX(1);
    }
  }

  .leads {
    display: grid;
    max-width: 46ch;
  }

  .lead {
    grid-area: 1 / 1;
    font-size: clamp(17px, 1.5vw, 20px);
    color: var(--paper-70);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 500ms,
      transform 500ms;
  }

  .lead.on {
    opacity: 1;
    transform: none;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 22px;
    margin-top: 4px;
  }

  /* Hero with the video. Desktop: headline at the top, the rest along the
     bottom, so the keke and courier crossing the middle stay in view. */
  .loop-fade {
    position: absolute;
    inset: 0;
    background: var(--ink);
    opacity: 0;
    transition: opacity 0.45s ease;
    pointer-events: none;
  }

  .hero.fading .loop-fade {
    opacity: 0.85;
  }

  .has-video .hero-shade {
    background:
      linear-gradient(180deg, rgb(16 19 23 / 0.75) 0%, rgb(16 19 23 / 0.15) 34%, rgb(16 19 23 / 0) 55%, rgb(16 19 23 / 0.85) 100%),
      linear-gradient(90deg, rgb(16 19 23 / 0.35) 0%, transparent 45%);
  }

  .has-video .hero-inner {
    min-height: min(100svh, 1100px);
    grid-template-columns: 1fr auto;
    align-content: space-between;
    align-items: end;
    gap: 24px 48px;
    padding-top: 108px;
  }

  .has-video h1 {
    grid-column: 1 / -1;
  }

  .has-video .title {
    max-width: none;
    font-size: clamp(50px, 7.6vw, 124px);
  }

  .hero-pick {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .has-video .hero-actions {
    justify-content: flex-end;
  }

  /* Intro and the two products */
  .intro {
    padding-block: clamp(80px, 11vw, 160px);
  }

  .statement {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(26px, 3.6vw, 48px);
    line-height: 1.2;
    letter-spacing: -0.03em;
    max-width: 1000px;
  }

  .lanes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--lg);
    margin-top: clamp(48px, 7vw, 96px);
  }

  .lane {
    position: relative;
    display: block;
    aspect-ratio: 5 / 6;
    border-radius: var(--r-lg);
    overflow: hidden;
    color: var(--paper);
    text-decoration: none;
    isolation: isolate;
  }

  .lane :global(.lane-photo) {
    position: absolute;
    inset: 0;
    z-index: -2;
    transition: transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .lane:hover :global(.lane-photo) {
    transform: scale(1.04);
  }

  .lane-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgb(16 19 23 / 0.88) 0%, rgb(16 19 23 / 0.35) 42%, transparent 62%);
  }

  .lane .chip {
    position: absolute;
    top: 18px;
    left: 18px;
  }

  .lane-copy {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 10px;
    padding: clamp(20px, 3vw, 36px);
  }

  .lane h3 {
    font-size: clamp(28px, 3.2vw, 44px);
  }

  .lane-body {
    max-width: 36ch;
    color: var(--paper-70);
  }

  .lane-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    font-weight: 700;
    font-size: 15px;
  }

  .lane-link :global(svg) {
    transition: transform 200ms;
  }

  .lane:hover .lane-link :global(svg) {
    transform: translateX(4px);
  }

  .pay-line {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: var(--xl);
    color: var(--ink-70);
    font-size: 16px;
  }

  .pay-line :global(svg) {
    flex: none;
    color: var(--ink);
  }

  /* Deza Ride */
  .how {
    background: var(--ink);
    color: var(--paper);
    padding-block: clamp(88px, 11vw, 160px);
  }

  .how-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .how-copy {
    min-width: 0;
  }

  .steps {
    list-style: none;
    margin: var(--xxl) 0 0;
    padding: 0;
  }

  .steps li {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: var(--md);
    padding-block: clamp(48px, 18vh, 180px) var(--lg);
    opacity: 0.35;
    transition: opacity 400ms;
  }

  .steps li:first-child {
    padding-top: var(--lg);
  }

  .steps li:global(.active) {
    opacity: 1;
  }

  .num {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--paper-55);
    font-family: var(--display);
    font-weight: 700;
    transition:
      background-color 300ms,
      color 300ms;
  }

  .steps li:global(.active) .num {
    background: var(--gold);
    color: var(--ink);
    box-shadow: none;
  }

  .steps h3 {
    font-size: clamp(22px, 2.2vw, 30px);
    margin-bottom: 8px;
  }

  .steps p {
    color: var(--paper-70);
    font-size: 17px;
    max-width: 40ch;
  }

  .how-visual {
    position: sticky;
    top: 92px;
  }

  .phone-shot {
    position: relative;
    aspect-ratio: 1000 / 1252;
    max-width: 100%;
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .phone-zoom,
  .phone-shot :global(.phone-photo) {
    position: absolute;
    inset: 0;
  }

  /* Matches the black screen in phone-in-hand.webp */
  .screen-slot {
    position: absolute;
    left: 31.6%;
    top: 23.1%;
    width: 36.8%;
    height: 64.6%;
  }

  /* Deza Delivery */
  .delivery {
    padding-block: clamp(88px, 11vw, 160px);
    overflow: hidden;
  }

  .delivery .kicker {
    gap: 12px;
  }

  .soon-chip {
    letter-spacing: 0.02em;
  }

  .delivery .body {
    color: var(--ink-70);
  }

  .d-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
    margin-top: clamp(40px, 6vw, 80px);
  }

  .d-visual {
    position: relative;
    padding-bottom: 12%;
  }

  .d-visual :global(.d-photo) {
    aspect-ratio: 4 / 5;
    width: 82%;
    border-radius: var(--r-lg);
  }

  /* A phone drawn in CSS, holding the live delivery screen. */
  .device {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 44%;
    aspect-ratio: 9 / 19.2;
    padding: 2.2%;
    border-radius: 15% / 7%;
    background: #0d0f12;
    box-shadow:
      inset 0 0 0 1.5px #3a3f46,
      0 40px 80px -24px rgb(16 19 23 / 0.55),
      0 12px 24px -12px rgb(16 19 23 / 0.4);
  }

  .device::before,
  .device::after {
    content: "";
    position: absolute;
    right: -1.6%;
    width: 1.6%;
    border-radius: 0 3px 3px 0;
    background: #2a2e34;
  }

  .device::before {
    top: 22%;
    height: 11%;
  }

  .device::after {
    top: 36%;
    height: 7%;
  }

  .device-screen {
    position: relative;
    height: 100%;
    border-radius: 13% / 6%;
    overflow: hidden;
  }

  .device-screen :global(.scr) {
    border-radius: inherit;
  }

  .d-copy {
    display: grid;
    gap: var(--xl);
    min-width: 0;
  }

  .d-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .d-steps li {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: var(--md);
    padding-block: 20px;
    border-top: 1px solid var(--ink-10);
  }

  .d-steps li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .d-num {
    font-family: var(--display);
    font-weight: 600;
    font-size: 15px;
    color: var(--ink-55);
    padding-top: 4px;
  }

  .d-steps h3 {
    font-size: 21px;
    margin-bottom: 6px;
  }

  .d-steps p,
  .biz p {
    color: var(--ink-70);
    font-size: 16px;
  }

  .sends h3,
  .biz h3 {
    font-size: 18px;
    margin-bottom: 14px;
  }

  .sends ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .sends li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-radius: var(--r-pill);
    background: var(--ink-6);
    font-size: 15px;
    font-weight: 600;
  }

  .biz {
    display: grid;
    gap: 6px;
    justify-items: start;
    padding: var(--lg);
    border-radius: var(--r-lg);
    background: var(--ink);
    color: var(--paper);
  }

  .biz h3 {
    margin-bottom: 4px;
  }

  .biz p {
    color: var(--paper-70);
    margin-bottom: 12px;
  }

  /* Safety */
  .safety {
    position: relative;
    color: var(--paper);
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(120px, 16vw, 220px) clamp(64px, 8vw, 112px);
  }

  .parallax {
    position: absolute;
    inset: -12% 0;
    z-index: -2;
  }

  .parallax :global(.safety-photo) {
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .parallax {
        animation-name: pan;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
      }
    }
  }

  @keyframes pan {
    from {
      transform: translateY(-8%);
    }
    to {
      transform: translateY(8%);
    }
  }

  .safety-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgb(16 19 23 / 0.95) 15%, rgb(16 19 23 / 0.4) 60%, rgb(16 19 23 / 0.2));
  }

  .safety-inner {
    display: grid;
    gap: var(--xxl);
  }

  .safety-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--xl);
  }

  .safety-list li {
    display: grid;
    gap: 10px;
    align-content: start;
    padding-top: var(--lg);
    border-top: 1px solid var(--paper-12);
  }

  .safety-list :global(svg) {
    color: var(--gold);
    margin-bottom: 6px;
  }

  .safety-list h3 {
    font-size: 20px;
  }

  .safety-list p {
    color: var(--paper-70);
    font-size: 16px;
  }

  /* Earn */
  .earn {
    padding-block: clamp(88px, 11vw, 160px);
  }

  .earn-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .earn-media {
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .earn-media :global(.earn-photo) {
    aspect-ratio: 4 / 5;
  }

  .earn-copy {
    display: grid;
    gap: var(--lg);
    justify-items: start;
    min-width: 0;
  }

  .earn h2 {
    font-size: clamp(32px, 4.2vw, 58px);
  }

  .earn .body {
    color: var(--ink-70);
  }

  .ticks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .ticks li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
    font-size: 17px;
  }

  /* Questions */
  .faq {
    padding-bottom: clamp(88px, 11vw, 160px);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .qs {
    border-top: 1px solid var(--ink-10);
  }

  details {
    border-bottom: 1px solid var(--ink-10);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--md);
    padding: 22px 0;
    font-weight: 650;
    font-size: 18px;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary i {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--ink-6);
  }

  summary i::before,
  summary i::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    margin: -1px 0 0 -6px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 250ms;
  }

  summary i::after {
    transform: rotate(90deg);
  }

  details[open] summary i::after {
    transform: rotate(0);
  }

  details p {
    padding-bottom: 22px;
    max-width: 60ch;
    color: var(--ink-70);
  }

  /* Join */
  .join {
    position: relative;
    color: var(--paper);
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(88px, 11vw, 160px);
  }

  .join :global(.join-photo) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .join-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(16 19 23 / 0.92) 0%, rgb(16 19 23 / 0.75) 45%, rgb(16 19 23 / 0.35) 100%);
  }

  .join-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--xxl);
    align-items: center;
  }

  .join-copy {
    display: grid;
    gap: var(--lg);
    justify-items: start;
    min-width: 0;
  }

  .join h2 {
    font-size: clamp(36px, 5.4vw, 78px);
    font-weight: 700;
  }

  .join .body {
    color: var(--paper-70);
  }

  .form {
    display: grid;
    gap: 10px;
    padding: var(--xl);
    border-radius: var(--r-lg);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.6);
  }

  .form > label,
  legend {
    font-size: 14px;
    font-weight: 600;
  }

  .form input[type="tel"],
  .form input[type="text"] {
    width: 100%;
    height: 54px;
    margin-bottom: 10px;
    padding: 0 var(--md);
    border-radius: var(--r-md);
    border: 1.5px solid var(--ink-10);
    background: #fff;
    font: 500 17px var(--font);
    color: var(--ink);
  }

  .form input:focus {
    outline: none;
    border-color: var(--ink);
  }

  fieldset {
    border: 0;
    margin: 0 0 var(--sm);
    padding: 0;
  }

  legend {
    margin-bottom: var(--sm);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sm);
  }

  .chips input {
    position: absolute;
    opacity: 0;
  }

  .chips span {
    display: inline-block;
    padding: 10px 18px;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1.5px var(--ink-10);
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
  }

  .chips input:checked + span {
    background: var(--ink);
    color: var(--paper);
    box-shadow: none;
  }

  .chips input:focus-visible + span {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
  }

  .form button {
    width: 100%;
  }

  .form button:disabled {
    opacity: 0.6;
  }

  .fine {
    font-size: 13px;
    color: var(--ink-55);
  }

  .status-msg:empty {
    display: none;
  }

  .status-msg {
    padding: 12px var(--md);
    border-radius: var(--r-md);
    background: var(--ink-6);
    font-weight: 600;
    font-size: 15px;
  }

  .status-msg[data-state="ok"] {
    background: var(--gold);
  }

  /* Footer */
  .foot {
    background: var(--ink);
    color: var(--paper-55);
    font-size: 15px;
    overflow: hidden;
  }

  .foot-top {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--lg) var(--xxl);
    padding-top: clamp(56px, 7vw, 88px);
  }

  .foot-tag {
    font-family: var(--display);
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--paper);
    max-width: 22ch;
  }

  .foot-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin: 0;
    align-self: start;
  }

  .areas {
    grid-column: 1 / -1;
    display: grid;
    gap: 6px;
    font-size: 14px;
  }

  .areas span {
    color: var(--paper);
    font-weight: 600;
  }

  .foot-mark {
    color: var(--paper);
    padding-block: clamp(40px, 7vw, 88px) clamp(24px, 4vw, 40px);
  }

  .foot-mark :global(.logo) {
    --h: clamp(44px, 12.6vw, 186px) !important;
  }

  .rights {
    padding-bottom: var(--xl);
    font-size: 13px;
  }

  /* Tablet */
  @media (max-width: 980px) {
    nav:not(.foot-nav) {
      display: none;
    }

    .bar-end {
      margin-left: auto;
    }

    .safety-list,
    .earn-grid,
    .join-grid,
    .d-grid,
    .faq-grid {
      grid-template-columns: 1fr;
    }

    .d-visual {
      max-width: 620px;
    }
  }

  /* Phone */
  @media (max-width: 720px) {
    .bar {
      height: 60px;
      gap: var(--md);
    }

    .btn-sm {
      min-height: 36px;
      padding: 0 12px;
      font-size: 13px;
    }

    .lang {
      padding: 7px 11px;
      font-size: 13px;
    }

    .hero-inner {
      gap: 18px;
      padding-bottom: 28px;
    }

    .eyebrow {
      font-size: 12px;
    }

    .modes button {
      min-height: 40px;
      padding: 0 16px;
      font-size: 14px;
    }

    .lead {
      font-size: 16px;
    }

    /* Phones: headline, then the whole video frame, then the rest. */
    .hero.has-video {
      min-height: 0;
      max-height: none;
      display: flex;
      flex-direction: column;
    }

    .has-video .hero-media {
      position: relative;
