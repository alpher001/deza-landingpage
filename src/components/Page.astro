  }

  /* Reveal: blocks rise in once as they come into view. The page script
     adds .motion-ok and .is-in, so without it (or with motion turned off)
     everything simply shows. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.motion-ok) .reveal {
      transition:
        opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
        transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
      transition-delay: calc(var(--i, 0) * 90ms);
    }

    :global(.motion-ok) .reveal:not(.is-in) {
      opacity: 0;
      transform: translateY(28px);
    }
  }

  /* Header */
  .top {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    color: var(--paper);
    background: linear-gradient(to bottom, rgb(var(--ink-rgb) / 0.5), transparent);
    isolation: isolate;
    will-change: transform;
    transition: transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .top.away {
    transform: translateY(-100%);
  }

  /* The solid, blurred backing is its own layer that fades in, so the bar
     never snaps from see-through to solid while you scroll. */
  .top::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--ink) 94%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--paper-6);
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .top.solid::before {
    opacity: 1;
  }

  /* Phones: a near-solid backing with no live blur. Blurring the page behind
     a moving bar is what made it stutter the first time it slid back in. */
  @media (max-width: 720px) {
    .top::before {
      background: color-mix(in srgb, var(--ink) 97%, transparent);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

