---
import fs from "node:fs";
import path from "node:path";
import Base from "../layouts/Base.astro";
import Photo from "./Photo.astro";
import Logo from "./Logo.astro";
import StoreBadges from "./StoreBadges.astro";
import ScreenUI from "./ScreenUI.astro";
import Cruise from "./Cruise.astro";
import Mark3D from "./Mark3D.astro";
import Icon from "./Icon.astro";
import { copy, type Lang } from "../i18n";
import { findAsset, srcsets } from "../lib/pictures";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const home = lang === "en" ? "/" : "/ha/";
// The waitlist endpoint is decided later. Until it is set, the form says
// sign-ups open soon instead of pretending to save anything.
const waitlistUrl = import.meta.env.PUBLIC_WAITLIST_URL ?? "";

const has = (p: string) => fs.existsSync(path.join(process.cwd(), "public", p));
const firstOf = (...names: string[]) =>
  names.find((n) => ["webp", "jpg", "jpeg", "png"].some((e) => fs.existsSync(path.join(process.cwd(), "src/assets/photos", `${n}.${e}`))));

// Hero: a video when one is in public/video/, otherwise the two photos.
const heroVideo = has("video/hero.mp4") ? "/video/hero.mp4" : null;
// The hero still is the first thing people see, so the browser is told
// about it in the head, before it even reads the page.
const heroWidths = [640, 960, 1280, 1920];
const heroStill = heroVideo ? await srcsets(findAsset("posters/hero")!, heroWidths) : null;
const cityVideo = has("video/city.mp4") ? "/video/city.mp4" : null;
const courierPhoto = firstOf("courier-city", "delivery-hand")!;
const doorstepPhoto = firstOf("courier-doorstep", "delivery-hand")!;
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} ogAlt={t.meta.ogAlt} faq={t.faq.items}>
  {heroStill && <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={heroStill.avif} imagesizes="100vw" fetchpriority="high" />}
  <header class="top" data-top>
    <div class="wrap bar">
      <a class="brand" href={home} aria-label="Deza"><Logo height={19} motion="intro" /></a>
      <nav aria-label="Main">
        <a href="#ride">{t.nav.ride}</a>
        <a href="#delivery">{t.nav.delivery}</a>
        <a href="#earn">{t.nav.earn}</a>
      </nav>
      <div class="bar-end">
        <a class="lang" href={t.nav.switchHref} hreflang={lang === "en" ? "ha" : "en"} lang={lang === "en" ? "ha" : "en"}>{t.nav.switchLabel}</a>
        <a class="btn btn-gold btn-sm" href="#join">{t.nav.cta}</a>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero: rides and deliveries, switching on their own -->
    <section class:list={["hero", { "has-video": heroVideo }]} data-hero data-mode="0">
      <div class="hero-media">
        {
          heroVideo ? (
            <>
              <Photo name="posters/hero" alt={t.hero.rideAlt} class="hero-poster" eager sizes="100vw" widths={heroWidths} />
              <video
                class="bg-video"
                muted
                loop
                playsinline
                preload="none"
                aria-hidden="true"
                data-av1="/video/hero-av1.mp4"
                data-mp4="/video/hero-1080.mp4"
                data-mp4-small="/video/hero.mp4"
              />
            </>
          ) : (
            <>
              <div class="layer l0">
                <Photo name="hero-keke" mobile="hero-keke-mobile" alt={t.hero.rideAlt} class="hero-photo" position="68% 50%" eager sizes="100vw" />
              </div>
              <div class="layer l1">
                <Photo name={courierPhoto} alt={t.hero.deliveryAlt} class="hero-photo" position="50% 40%" sizes="100vw" />
              </div>
            </>
          )
        }
      </div>
      <div class="hero-shade" aria-hidden="true"></div>

      <div class="wrap hero-inner">
        <h1>
          <span class="eyebrow load" style="--d:0">{t.hero.eyebrow}</span>
          <span class="title">
            {t.hero.title.map((w, i) => (
              <span class="word-mask">
                <span class:list={["load-word", { gold: i === 2 }]} style={`--d:${i}`}>{w}</span>
              </span>
            ))}
          </span>
        </h1>

        <div class="hero-pick">
        <div class="modes load" style="--d:4" role="tablist" aria-label="Deza">
          {
            t.hero.modes.map((m, i) => (
              <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-mode-btn={i}>
                <Icon name={i === 0 ? "pin" : "package"} size={16} stroke={2} />
                {m.label}
                <i class="fill" aria-hidden="true" />
              </button>
            ))
          }
        </div>

        <div class="leads load" style="--d:5">
          {t.hero.modes.map((m, i) => <p class:list={["lead", { on: i === 0 }]} data-lead={i}>{m.lead}</p>)}
        </div>
        </div>

        <div class="hero-actions load" style="--d:6">
          <a class="btn btn-gold" href="#join">{t.hero.cta}<Icon name="arrow" size={18} stroke={2.25} /></a>
          <StoreBadges label={t.hero.soon} />
        </div>
      </div>
    </section>

    <!-- Deza Ride: the phone plays through booking a keke, step by step -->
    <section id="ride" class="how" data-steps data-step="1">
      <div class="wrap how-grid">
        <div class="how-copy">
          <div class="head">
            <span class="chip chip-gold">{t.how.kicker} · {t.lanes.items[0].status}</span>
            <h2>{t.how.title}</h2>
          </div>
          <ol class="steps" data-stepper>
            {
              t.how.steps.map((s, i) => (
                <li>
                  <button type="button" data-step-btn={i + 1} aria-pressed={i === 0 ? "true" : "false"}>
                    <span class="num">{i + 1}</span>
                    <span class="step-text">
                      <span class="step-title">{s.title}</span>
                      <span class="step-body">{s.body}</span>
                    </span>
                    <i class="bar" aria-hidden="true" />
                  </button>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="how-visual">
          <div class="phone-shot">
            <div class="phone-zoom">
              <Photo name="phone-in-hand" alt={t.how.photoAlt} class="phone-photo" sizes="(max-width: 900px) 100vw, 46vw" widths={[480, 720, 1000]} />
              <div class="screen-slot"><ScreenUI t={t.screen} /></div>
            </div>
          </div>
        </div>
      </div>

      <ul id="safety" class="wrap trust">
        {
          t.safety.items.map((s, i) => (
            <li>
              <Icon name={(["shield", "share", "tag"] as const)[i]} size={22} />
              <div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Deza Delivery -->
    <section id="delivery" class="delivery">
      <div class="wrap d-grid">
        <div class="d-copy">
          <div class="head">
            <span class="chip chip-ink">{t.delivery.kicker} · {t.delivery.status}</span>
            <h2>{t.delivery.title}</h2>
            <p class="body">{t.delivery.body}</p>
          </div>

          <ol class="d-steps">
            {
              t.delivery.steps.map((s, i) => (
                <li>
                  <span class="d-num">{i + 1}</span>
                  <div>
                    <h3>{s.title}</h3>
                    <p>{s.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>

          <ul class="sends" aria-label={t.delivery.sendsTitle}>
            {t.delivery.sends.map((s, i) => (
              <li>
                <Icon name={(["doc", "bag", "store", "phone"] as const)[i]} size={16} />
                {s}
              </li>
            ))}
          </ul>
        </div>

        <div class="d-visual">
          <Photo name={doorstepPhoto} alt={t.delivery.photoAlt} class="d-photo" position="55% 45%" sizes="(max-width: 900px) 84vw, 36vw" widths={[480, 720, 960, 1280]} />
          <div class="device">
            <div class="device-screen"><ScreenUI t={t.screen} mode="delivery" /></div>
          </div>
        </div>
      </div>

      <div class="wrap">
        <div class="biz">
          <div>
            <h3>{t.delivery.bizTitle}</h3>
            <p>{t.delivery.bizBody}</p>
          </div>
          <a class="btn btn-gold" href="#join" data-role="send">{t.delivery.cta}<Icon name="arrow" size={18} stroke={2.25} /></a>
        </div>
      </div>
    </section>

    <Cruise places={t.footer.areas} />

    <!-- Earn -->
    <section id="earn" class="earn">
      <div class="wrap earn-grid">
        <div class="earn-media reveal">
          <Photo name="driver-portrait" alt={t.earn.photoAlt} class="earn-photo" position="50% 35%" sizes="(max-width: 900px) 100vw, 46vw" widths={[480, 720, 960, 1280, 1600]} />
        </div>
        <div class="earn-copy reveal">
          <h2>{t.earn.title}</h2>
          <p class="body">{t.earn.body}</p>
          <ul class="ticks">
            {
              t.earn.points.map((p) => (
                <li>
                  <Icon name="check" size={18} stroke={2.5} />
                  {p}
                </li>
              ))
            }
          </ul>
          <a class="btn btn-ink" href="#join" data-role="drive">{t.earn.cta}</a>
        </div>
      </div>
    </section>

    <!-- Questions -->
    <section id="faq" class="faq">
      <div class="wrap faq-grid">
        <div class="head">
          <h2>{t.faq.title}</h2>
        </div>
        <div class="qs">
          {
            t.faq.items.map((f, i) => (
              <details>
                <summary>
                  {f.q}
                  <i aria-hidden="true" />
                </summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Join -->
    <section id="join" class="join">
      <div class="join-media">
        <Photo name="posters/city" alt="" class="join-photo" position="50% 85%" sizes="100vw" widths={[640, 960, 1280]} />
        {cityVideo && <video class="bg-video" muted loop playsinline preload="none" aria-hidden="true" data-av1="/video/city-av1.mp4" data-mp4={cityVideo} data-start="0.6" />}
      </div>
      <div class="join-shade" aria-hidden="true"></div>
      <div class="wrap join-grid">
        <div class="join-copy reveal">
          <Mark3D size={200} />
          <h2>{t.app.title}</h2>
          <p class="body">{t.app.body}</p>
          <StoreBadges label={t.hero.soon} />
        </div>
        <form
          class="form reveal"
          data-endpoint={waitlistUrl}
          data-msg-success={t.waitlist.success}
          data-msg-closed={t.waitlist.notOpen}
          data-msg-error={t.waitlist.error}
        >
          <label for={`wl-phone-${lang}`}>{t.waitlist.phone}</label>
          <input
            id={`wl-phone-${lang}`}
            name="phone"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            required
            pattern="[0-9+ ]{10,16}"
            placeholder={t.waitlist.phonePlaceholder}
          />
          <label for={`wl-area-${lang}`}>{t.waitlist.area}</label>
          <input id={`wl-area-${lang}`} name="area" type="text" autocomplete="address-level3" placeholder={t.waitlist.areaPlaceholder} />
          <fieldset>
            <legend>{t.waitlist.role}</legend>
            <div class="chips">
              <label><input type="radio" name="role" value="ride" checked /><span>{t.waitlist.roles.ride}</span></label>
              <label><input type="radio" name="role" value="send" /><span>{t.waitlist.roles.send}</span></label>
              <label><input type="radio" name="role" value="drive" /><span>{t.waitlist.roles.drive}</span></label>
            </div>
          </fieldset>
          <input type="hidden" name="lang" value={lang} />
          <button class="btn btn-gold" type="submit">{t.waitlist.submit}</button>
          <p class="fine">{t.waitlist.privacy}</p>
          <p class="status-msg" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap">
      <div class="foot-top">
        <p class="foot-tag">{t.footer.tagline}</p>
        <nav class="foot-nav" aria-label="Footer">
          <a href="#ride">{t.nav.ride}</a>
          <a href="#delivery">{t.nav.delivery}</a>
          <a href="#earn">{t.nav.earn}</a>
          <a href="#faq">{t.nav.faq}</a>
          <a href={t.nav.switchHref} hreflang={lang === "en" ? "ha" : "en"}>{t.nav.switchLabel}</a>
        </nav>
        <div class="areas">
          <span>{t.footer.areasTitle}</span>
          <p>{t.footer.areas.join(" · ")}</p>
        </div>
      </div>
      <div class="foot-mark"><Logo height={120} motion="scroll" /></div>
      <p class="rights">© {new Date().getFullYear()} {t.footer.rights}</p>
    </div>
  </footer>
</Base>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Header turns solid once you scroll past the top.
  const top = document.querySelector<HTMLElement>("[data-top]");
  const onScroll = () => top?.classList.toggle("solid", scrollY > 40);
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Hero: Ride and Delivery take turns. Each tab fills while it is showing;
  // when it is full the other one takes over. Tapping a tab picks it.
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (hero) {
    const btns = [...hero.querySelectorAll<HTMLButtonElement>("[data-mode-btn]")];
    const leads = [...hero.querySelectorAll<HTMLElement>("[data-lead]")];
    const set = (i: number) => {
      hero.dataset.mode = String(i);
      btns.forEach((b, k) => b.setAttribute("aria-selected", String(k === i)));
      leads.forEach((l, k) => l.classList.toggle("on", k === i));
    };
    btns.forEach((b, i) =>
      b.addEventListener("click", () => {
        hero.classList.add("picked");
        set(i);
      }),
    );
    if (!reduce) {
      btns.forEach((b, i) =>
        b.querySelector(".fill")?.addEventListener("animationend", () => {
          if (!hero.classList.contains("picked")) set((i + 1) % btns.length);
        }),
      );
      // Pause the turn-taking while the hero is off screen.
      new IntersectionObserver(([e]) => hero.classList.toggle("paused", !e.isIntersecting)).observe(hero);
    }
  }

  // Background videos. The page paints with the still frame first; a video
  // only starts downloading after the page has loaded and once it is near
  // the screen, then fades in over its still once it is actually playing.
  // AV1 where the device decodes it (sharper at half the size), H.264
  // elsewhere, with a lighter H.264 file for phones.
  // Each clip is cut to loop on itself, so there is no jump to hide. They
  // pause off screen and stay as stills when motion is off or data is saved.
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  const startVideos = () => {
    const av1 = document.createElement("video").canPlayType('video/mp4; codecs="av01.0.05M.10"') === "probably";
    const phone = matchMedia("(max-width: 720px)").matches;
    document.querySelectorAll<HTMLVideoElement>("video[data-mp4]").forEach((v) => {
      let loaded = false;
      v.addEventListener("playing", () => v.classList.add("on"), { once: true });
      new IntersectionObserver(
        ([e]) => {
          if (!e.isIntersecting) return v.pause();
          if (!loaded) {
            loaded = true;
            const d = v.dataset;
            // Start on the frame the still shows, so the fade-in has no ghosting.
            v.src = ((av1 && d.av1) || (phone && d.mp4Small) || d.mp4!) + (d.start ? `#t=${d.start}` : "");
          }
          v.play().catch(() => {});
        },
        { rootMargin: "200px" },
      ).observe(v.parentElement!);
    });
  };
  if (!reduce && !saveData) {
    if (document.readyState === "complete") startVideos();
    else addEventListener("load", startVideos, { once: true });
  }

  // Ride: the phone plays the three steps in turn. Each step's bar fills
  // while it shows; tapping a step jumps to it. It only runs while the
  // section is on screen, and steps by tap only when motion is turned off.
  const how = document.querySelector<HTMLElement>("[data-steps]");
  const stepBtns = [...document.querySelectorAll<HTMLButtonElement>("[data-step-btn]")];
  if (how && stepBtns.length) {
    const show = (n: number) => {
      how.dataset.step = String(n);
      stepBtns.forEach((b, k) => b.setAttribute("aria-pressed", String(k + 1 === n)));
    };
    stepBtns.forEach((b, k) => {
      b.addEventListener("click", () => {
        how.classList.add("picked");
        show(k + 1);
      });
      b.querySelector(".bar")?.addEventListener("animationend", () => {
        if (!how.classList.contains("picked")) show((k + 1) % stepBtns.length + 1);
      });
    });
    new IntersectionObserver(([e]) => how.classList.toggle("running", e.isIntersecting && !reduce), { threshold: 0.35 }).observe(how);
  }

  // Buttons like "Register to drive" pre-select the matching option.
  document.querySelectorAll<HTMLAnchorElement>("a[data-role]").forEach((a) => {
    a.addEventListener("click", () => {
      const radio = document.querySelector<HTMLInputElement>(`input[name=role][value=${a.dataset.role}]`);
      if (radio) radio.checked = true;
    });
  });

  const form = document.querySelector<HTMLFormElement>("form.form");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const status = form.querySelector<HTMLElement>(".status-msg")!;
    const button = form.querySelector<HTMLButtonElement>("button")!;
    const { endpoint, msgSuccess, msgClosed, msgError } = form.dataset;
    status.dataset.state = "";
    if (!endpoint) {
      status.textContent = msgClosed ?? "";
      return;
    }
    button.disabled = true;
    try {
      const res = await fetch(endpoint, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      if (!res.ok) throw new Error(String(res.status));
      status.textContent = msgSuccess ?? "";
      status.dataset.state = "ok";
      form.reset();
    } catch {
      status.textContent = msgError ?? "";
      status.dataset.state = "error";
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  h1,
  h2,
  h3 {
    font-family: var(--display);
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  h2 {
    font-size: clamp(30px, 4.6vw, 62px);
    line-height: 1.04;
  }

  .head {
    display: grid;
    gap: var(--md);
    max-width: 860px;
  }

  .kicker {
    color: var(--gold);
  }

  .kicker.dark {
    color: var(--ink);
  }

  .body {
    font-size: 18px;
    max-width: 48ch;
  }

  .btn-sm {
    white-space: nowrap;
    min-height: 40px;
    padding: 0 16px;
    font-size: 14px;
    border-radius: 10px;
  }

  .btn-ink {
    background: var(--ink);
    color: var(--paper);
  }

  .btn-ink:hover {
    background: color-mix(in srgb, var(--ink) 85%, white);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    border-radius: var(--r-pill);
    background: var(--paper);
    color: var(--ink);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .chip-gold {
    background: var(--gold);
  }

  /* Reveal on scroll. Resting state is fully visible; only browsers with
     scroll-driven animations get the rise-in. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .reveal {
        animation-name: rise;
        animation-fill-mode: both;
        animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
        animation-timeline: view();
        animation-range: entry calc(var(--i, 0) * 5%) entry calc(50% + var(--i, 0) * 5%);
      }
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
  }

  /* Header */
  .top {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    color: var(--paper);
    background: linear-gradient(to bottom, rgb(var(--ink-rgb) / 0.5), transparent);
    transition:
      background-color 250ms,
      box-shadow 250ms;
  }

  .top.solid {
    background: color-mix(in srgb, var(--ink) 94%, transparent);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--paper-6);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--lg);
    height: 68px;
  }

  .brand {
    color: var(--paper);
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 28px;
    margin-inline: auto;
    font-size: 15px;
    font-weight: 500;
  }

  nav a,
  .lang {
    color: var(--paper-70);
    text-decoration: none;
    transition: color 150ms;
  }

  nav a:hover,
  .lang:hover {
    color: var(--paper);
  }

  .bar-end {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .lang {
    font-size: 14px;
    font-weight: 600;
    padding: 8px 13px;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1px var(--paper-12);
  }

  /* Hero */
  .hero {
    position: relative;
    min-height: 100svh;
    max-height: 1100px;
    display: grid;
    align-items: end;
    color: var(--paper);
    background: var(--ink);
    overflow: hidden;
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  /* The still frame paints first; the video fades in over it once playing. */
  .hero-media :global(.hero-poster),
  .bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bg-video {
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .bg-video.on {
    opacity: 1;
  }

  .layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.1s ease;
  }

  .layer :global(.hero-photo) {
    width: 100%;
    height: 100%;
  }

  [data-mode="0"] .l0,
  [data-mode="1"] .l1 {
    opacity: 1;
  }

  /* Each photo travels while it is on screen: the keke drifts in from the
     right, the courier from the left. */
  @media (prefers-reduced-motion: no-preference) {
    .layer :global(img) {
      transition: transform 7s cubic-bezier(0.25, 0.1, 0.25, 1);
      transform: scale(1.14) translateX(var(--from, 3%));
    }

    .l1 {
      --from: -3%;
    }

    [data-mode="0"] .l0 :global(img),
    [data-mode="1"] .l1 :global(img) {
      transform: scale(1.04) translateX(0);
    }
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(0deg, rgb(var(--ink-rgb) / 0.92) 0%, rgb(var(--ink-rgb) / 0.55) 38%, rgb(var(--ink-rgb) / 0) 68%),
      linear-gradient(90deg, rgb(var(--ink-rgb) / 0.55) 0%, transparent 55%);
  }

  .hero-inner {
    display: grid;
    justify-items: start;
    gap: 22px;
    padding-top: 120px;
    padding-bottom: clamp(40px, 6vw, 80px);
  }

  .hero h1 {
    display: grid;
    gap: 14px;
    margin: 0;
  }

  .eyebrow {
    font-family: var(--font);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper-70);
  }

  .title {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.26em;
    max-width: 12ch;
    font-size: clamp(50px, 9.4vw, 148px);
    line-height: 0.94;
    font-weight: 700;
    letter-spacing: -0.05em;
  }

  .word-mask {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  /* The headline is there from the first paint. The words only settle up
     into place, so nothing waits on an animation to become readable. */
  @media (prefers-reduced-motion: no-preference) {
    .load-word {
      display: inline-block;
      animation: word 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
      animation-delay: calc(var(--d) * 60ms);
    }

    .load {
      animation: up 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
      animation-delay: calc(var(--d) * 40ms);
    }
  }

  @keyframes word {
    from {
      transform: translateY(28%);
    }
  }

  .gold {
    color: var(--gold);
  }

  @keyframes up {
    from {
      transform: translateY(10px);
    }
  }

  .modes {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    border-radius: var(--r-pill);
    background: rgb(var(--ink-rgb) / 0.5);
    box-shadow: inset 0 0 0 1px var(--paper-12);
    backdrop-filter: blur(10px);
  }

  .modes button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 18px;
    border: 0;
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--paper-70);
    font: 700 15px/1 var(--font);
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    transition: color 250ms;
  }

  .modes button[aria-selected="true"] {
    color: var(--ink);
    background: var(--paper);
  }

  /* The fill is the timer: when it reaches the end, the other tab takes over. */
  .fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
  }

  @media (prefers-reduced-motion: no-preference) {
    .modes button[aria-selected="true"] .fill {
      animation: fill 6.5s linear forwards;
    }

    .hero.paused .modes .fill {
      animation-play-state: paused;
    }

    .hero.picked .modes .fill {
      animation: none;
      transform: scaleX(1);
      opacity: 0;
    }
  }

  @keyframes fill {
    to {
      transform: scaleX(1);
    }
  }

  .leads {
    display: grid;
    max-width: 46ch;
  }

  .lead {
    grid-area: 1 / 1;
    font-size: clamp(17px, 1.5vw, 20px);
    color: var(--paper-70);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 500ms,
      transform 500ms;
  }

  .lead.on {
    opacity: 1;
    transform: none;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 22px;
    margin-top: 4px;
  }

  /* Hero with the video. Desktop: headline at the top, the rest along the
     bottom, so the keke and courier crossing the middle stay in view. */
  .has-video .hero-shade {
    background:
      linear-gradient(180deg, rgb(var(--ink-rgb) / 0.75) 0%, rgb(var(--ink-rgb) / 0.15) 34%, rgb(var(--ink-rgb) / 0) 55%, rgb(var(--ink-rgb) / 0.85) 100%),
      linear-gradient(90deg, rgb(var(--ink-rgb) / 0.35) 0%, transparent 45%);
  }

  .has-video .hero-inner {
    min-height: min(100svh, 1100px);
    grid-template-columns: 1fr auto;
    align-content: space-between;
    align-items: end;
    gap: 24px 48px;
    padding-top: 108px;
  }

  .has-video h1 {
    grid-column: 1 / -1;
  }

  .has-video .title {
    max-width: none;
    font-size: clamp(50px, 7.6vw, 124px);
  }

  .hero-pick {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .has-video .hero-actions {
    justify-content: flex-end;
  }

  /* Deza Ride */
  .how {
    background: var(--ink);
    color: var(--paper);
    padding-block: clamp(80px, 9vw, 128px) clamp(56px, 6vw, 88px);
  }

  .how-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .how-copy {
    display: grid;
    gap: var(--xl);
    min-width: 0;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .steps button {
    position: relative;
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: var(--md);
    width: 100%;
    padding: 18px 18px 20px;
    border: 0;
    border-radius: var(--r-lg);
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    transition: background-color 300ms;
  }

  .steps button[aria-pressed="true"] {
    background: var(--paper-6);
  }

  .num {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--paper-55);
    font-family: var(--display);
    font-weight: 700;
    font-size: 15px;
    transition:
      background-color 300ms,
      color 300ms;
  }

  [aria-pressed="true"] .num {
    background: var(--gold);
    color: var(--ink);
    box-shadow: none;
  }

  .step-text {
    display: grid;
    gap: 6px;
  }

  .step-title {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(19px, 1.7vw, 23px);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  /* Every step stays readable; only the open one shows its detail. */
  .step-body {
    color: var(--paper-70);
    font-size: 16px;
    display: none;
  }

  [aria-pressed="true"] .step-body {
    display: block;
    animation: up 0.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  /* The bar under the open step is its timer. */
  .bar {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 0;
    height: 2px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    opacity: 0;
  }

  .how.running:not(.picked) [aria-pressed="true"] .bar {
    opacity: 1;
    animation: fill var(--dur, 6s) linear forwards;
  }

  .steps li:last-child .bar {
    --dur: 8s;
  }

  .how-visual {
    min-width: 0;
  }

  .phone-shot {
    position: relative;
    aspect-ratio: 1000 / 1252;
    max-width: 100%;
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .phone-zoom,
  .phone-shot :global(.phone-photo) {
    position: absolute;
    inset: 0;
  }

  /* Matches the black screen in phone-in-hand.webp */
  .screen-slot {
    position: absolute;
    left: 31.6%;
    top: 23.1%;
    width: 36.8%;
    height: 64.6%;
  }

  .trust {
    list-style: none;
    margin-block: clamp(56px, 7vw, 96px) 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--lg);
  }

  .trust li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 14px;
    padding-top: var(--lg);
    border-top: 1px solid var(--paper-12);
  }

  .trust :global(svg) {
    color: var(--gold);
    margin-top: 2px;
  }

  .trust h3 {
    font-family: var(--font);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 4px;
  }

  .trust p {
    color: var(--paper-70);
    font-size: 15px;
  }

  /* Deza Delivery */
  .delivery {
    padding-block: clamp(80px, 9vw, 128px);
    overflow: hidden;
  }

  .chip-ink {
    background: var(--ink);
    color: var(--paper);
  }

  .head .chip {
    justify-self: start;
  }

  .delivery h2 {
    font-size: clamp(30px, 3.6vw, 52px);
  }

  .delivery .body {
    color: var(--ink-70);
  }

  .d-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .d-copy {
    display: grid;
    gap: var(--xl);
    min-width: 0;
  }

  .d-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }

  .d-steps li {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 14px;
  }

  .d-num {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--gold);
    font-family: var(--display);
    font-weight: 700;
    font-size: 14px;
  }

  .d-steps h3 {
    font-family: var(--font);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 2px;
  }

  .d-steps p {
    color: var(--ink-70);
    font-size: 15px;
  }

  .sends {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .sends li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 13px;
    border-radius: var(--r-pill);
    background: var(--ink-6);
    font-size: 14px;
    font-weight: 600;
  }

  .d-visual {
    position: relative;
    padding-bottom: 10%;
    min-width: 0;
  }

  .d-visual :global(.d-photo) {
    aspect-ratio: 4 / 5;
    width: 80%;
    border-radius: var(--r-lg);
  }

  /* A phone drawn in CSS, holding the live delivery screen. */
  .device {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 44%;
    aspect-ratio: 9 / 19.2;
    padding: 2.2%;
    border-radius: 15% / 7%;
    background: #0d0f12;
    box-shadow:
      inset 0 0 0 1.5px #3a3f46,
      0 40px 80px -24px rgb(var(--ink-rgb) / 0.55),
      0 12px 24px -12px rgb(var(--ink-rgb) / 0.4);
  }

  .device::before,
  .device::after {
    content: "";
    position: absolute;
    right: -1.6%;
    width: 1.6%;
    border-radius: 0 3px 3px 0;
    background: #2a2e34;
  }

  .device::before {
    top: 22%;
    height: 11%;
  }

  .device::after {
    top: 36%;
    height: 7%;
  }

  .device-screen {
    position: relative;
    height: 100%;
    border-radius: 13% / 6%;
    overflow: hidden;
  }

  .device-screen :global(.scr) {
    border-radius: inherit;
  }

  .biz {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--lg);
    margin-top: clamp(48px, 6vw, 80px);
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--r-lg);
    background: var(--ink);
    color: var(--paper);
  }

  .biz h3 {
    font-size: 20px;
    margin-bottom: 6px;
  }

  .biz p {
    color: var(--paper-70);
    font-size: 15px;
    max-width: 56ch;
  }

  /* Earn */
  .earn {
    padding-block: clamp(88px, 11vw, 160px);
  }

  .earn-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .earn-media {
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .earn-media :global(.earn-photo) {
    aspect-ratio: 4 / 5;
  }

  .earn-copy {
    display: grid;
    gap: var(--lg);
    justify-items: start;
    min-width: 0;
  }

  .earn h2 {
    font-size: clamp(32px, 4.2vw, 58px);
  }

  .earn .body {
    color: var(--ink-70);
  }

  .ticks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .ticks li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
    font-size: 17px;
  }

  /* Questions */
  .faq {
    padding-bottom: clamp(88px, 11vw, 160px);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .qs {
    border-top: 1px solid var(--ink-10);
  }

  details {
    border-bottom: 1px solid var(--ink-10);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--md);
    padding: 22px 0;
    font-weight: 650;
    font-size: 18px;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary i {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--ink-6);
  }

  summary i::before,
  summary i::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    margin: -1px 0 0 -6px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 250ms;
  }

  summary i::after {
    transform: rotate(90deg);
  }

  details[open] summary i::after {
    transform: rotate(0);
  }

  details p {
    padding-bottom: 22px;
    max-width: 60ch;
    color: var(--ink-70);
  }

  /* Join */
  .join {
    position: relative;
    color: var(--paper);
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(88px, 11vw, 160px);
  }

  .join-media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .join-media :global(.join-photo) {
    position: absolute;
    inset: 0;
  }

  .join-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(var(--ink-rgb) / 0.92) 0%, rgb(var(--ink-rgb) / 0.75) 45%, rgb(var(--ink-rgb) / 0.35) 100%);
  }

  .join-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--xxl);
    align-items: center;
  }

  .join-copy {
    display: grid;
    gap: var(--lg);
    justify-items: start;
    min-width: 0;
  }

  .join h2 {
    font-size: clamp(36px, 5.4vw, 78px);
    font-weight: 700;
  }

  .join .body {
    color: var(--paper-70);
  }

  .form {
    display: grid;
    gap: 10px;
    padding: var(--xl);
    border-radius: var(--r-lg);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.6);
  }

  .form > label,
  legend {
    font-size: 14px;
    font-weight: 600;
  }

  .form input[type="tel"],
  .form input[type="text"] {
    width: 100%;
    height: 54px;
    margin-bottom: 10px;
    padding: 0 var(--md);
    border-radius: var(--r-md);
    border: 1.5px solid var(--ink-10);
    background: #fff;
    font: 500 17px var(--font);
    color: var(--ink);
  }

  .form input:focus {
    outline: none;
    border-color: var(--ink);
  }

  fieldset {
    border: 0;
    margin: 0 0 var(--sm);
    padding: 0;
  }

  legend {
    margin-bottom: var(--sm);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sm);
  }

  .chips input {
    position: absolute;
    opacity: 0;
  }

  .chips span {
    display: inline-block;
    padding: 10px 18px;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1.5px var(--ink-10);
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
  }

  .chips input:checked + span {
    background: var(--ink);
    color: var(--paper);
    box-shadow: none;
  }

  .chips input:focus-visible + span {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
  }

  .form button {
    width: 100%;
  }

  .form button:disabled {
    opacity: 0.6;
  }

  .fine {
    font-size: 13px;
    color: var(--ink-55);
  }

  .status-msg:empty {
    display: none;
  }

  .status-msg {
    padding: 12px var(--md);
    border-radius: var(--r-md);
    background: var(--ink-6);
    font-weight: 600;
    font-size: 15px;
  }

  .status-msg[data-state="ok"] {
    background: var(--gold);
  }

  /* Footer */
  .foot {
    background: var(--ink);
    color: var(--paper-55);
    font-size: 15px;
    overflow: hidden;
  }

  .foot-top {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--lg) var(--xxl);
    padding-top: clamp(56px, 7vw, 88px);
  }

  .foot-tag {
    font-family: var(--display);
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--paper);
    max-width: 22ch;
  }

  .foot-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin: 0;
    align-self: start;
  }

  .areas {
    grid-column: 1 / -1;
    display: grid;
    gap: 6px;
    font-size: 14px;
  }

  .areas span {
    color: var(--paper);
    font-weight: 600;
  }

  .foot-mark {
    color: var(--paper);
    padding-block: clamp(40px, 7vw, 88px) clamp(24px, 4vw, 40px);
  }

  .foot-mark :global(.logo) {
    --h: clamp(44px, 12.6vw, 186px) !important;
  }

  .rights {
    padding-bottom: var(--xl);
    font-size: 13px;
  }

  /* Tablet */
  @media (max-width: 980px) {
    nav:not(.foot-nav) {
      display: none;
    }

    .bar-end {
      margin-left: auto;
    }

    .earn-grid,
    .join-grid,
    .d-grid,
    .faq-grid,
    .trust {
      grid-template-columns: 1fr;
    }

    .d-visual {
      max-width: 620px;
    }
  }

  /* Phone */
  @media (max-width: 720px) {
    .bar {
      height: 60px;
      gap: var(--md);
    }

    .btn-sm {
      min-height: 36px;
      padding: 0 12px;
      font-size: 13px;
    }

    .lang {
      padding: 7px 11px;
      font-size: 13px;
    }

    .hero-inner {
      gap: 18px;
      padding-bottom: 28px;
    }

    .eyebrow {
      font-size: 12px;
    }

    .modes button {
      min-height: 44px;
      padding: 0 16px;
      font-size: 14px;
    }

    .lead {
      font-size: 16px;
    }

    /* Phones: headline, then the whole video frame, then the rest. */
    .hero.has-video {
      min-height: 0;
      max-height: none;
      display: flex;
      flex-direction: column;
    }

    .has-video .hero-media {
      position: relative;
      order: 2;
      inset: auto;
      align-self: stretch;
      z-index: 0;
      aspect-ratio: 16 / 10;
      margin-top: 18px;
    }

    .has-video .hero-shade {
      display: none;
    }

    .has-video .hero-inner {
      display: contents;
    }

    .has-video h1,
    .has-video .hero-pick,
    .has-video .hero-actions {
      padding-inline: var(--gutter);
    }

    .has-video h1 {
      order: 1;
      padding-top: 92px;
    }

    .has-video .hero-pick {
      order: 3;
      padding-top: 20px;
    }

    .has-video .hero-actions {
      order: 4;
      justify-content: flex-start;
      padding-top: 20px;
      padding-bottom: 36px;
    }

    .has-video .title {
      font-size: clamp(44px, 13vw, 60px);
    }

    .hero-actions {
      width: 100%;
    }

    .hero-actions .btn {
      width: 100%;
    }

    /* Ride: phone first, the steps right under it. */
    .how-grid {
      grid-template-columns: 1fr;
      gap: var(--lg);
    }

    .how-copy {
      display: contents;
    }

    .how-copy .head {
      order: 1;
    }

    .how-visual {
      order: 2;
    }

    .steps {
      order: 3;
