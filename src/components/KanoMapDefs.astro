---
// The Kano street map, defined once per page and drawn inside each phone
// screen with <use href="#kano-map">. Generated by scripts/make-map.mjs.
import map from "../generated/kano-map.json";
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <symbol id="kano-map" viewBox={`0 0 ${map.width} ${map.height}`} set:html={map.svg} />
</svg>
