---
// Almustafa's own mark and wordmark (public/brand/), drawn inline so they
// take the colour of the text around them.
import fs from "node:fs";
import path from "node:path";

interface Props {
  height?: number;
}

const { height = 24 } = Astro.props;

function inline(file: string) {
  return fs
    .readFileSync(path.join(process.cwd(), "public/brand", file), "utf8")
    .replace(/<\?xml[^>]*>/, "")
    .replace(/\s(width|height)="[^"]*"/g, "")
    .replace(/fill="(black|#F2EEE3)"/gi, 'fill="currentColor"')
    .replace("<svg", '<svg aria-hidden="true" focusable="false"');
}

const mark = inline("mark.svg");
const word = inline("wordmark.svg");
---

<span class="logo" style={`--h:${height}px`}>
  <span class="mark" set:html={mark} />
  <span class="word" set:html={word} />
  <span class="sr-only">Deza</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--h) * 0.42);
    line-height: 0;
  }

  .mark :global(svg) {
    height: calc(var(--h) * 1.3);
    width: auto;
  }

  .word :global(svg) {
    height: var(--h);
    width: auto;
  }
</style>
