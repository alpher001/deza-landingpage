---
// Almustafa's mark and wordmark (public/brand/), drawn inline so they take the
// colour of the text around them. The wordmark is split into its four letters
// so they can move on their own.
//
// motion="intro":  plays once on load (header).
// motion="scroll": plays once as it comes into view (footer).
import fs from "node:fs";
import path from "node:path";

interface Props {
  height?: number;
  motion?: "none" | "intro" | "scroll";
}

const { height = 24, motion = "none" } = Astro.props;
const read = (f: string) => fs.readFileSync(path.join(process.cwd(), "public/brand", f), "utf8");

// Mark: one shape (the file repeats it twice; keep the first).
const markSvg = read("mark.svg");
const markView = markSvg.match(/viewBox="([^"]+)"/)![1];
const markPath = markSvg.match(/<path[^>]*\sd="([^"]+)"/)![1];

// Wordmark: one path made of subpaths. Group them by x position into D, E, Z, A.
const wordSvg = read("wordmark.svg");
const wordView = wordSvg.match(/viewBox="([^"]+)"/)![1];
const wordD = wordSvg.match(/\sd="([^"]+)"/)![1];
const subs = wordD.split(/(?=M)/).map((s) => s.trim()).filter(Boolean);
const minX = (s: string) => Math.min(...[...s.matchAll(/(-?\d+\.?\d*),(-?\d+\.?\d*)/g)].map((m) => Number(m[1])));
const bounds = [600, 1150, 1700, Infinity];
const letters = bounds.map((b, i) => subs.filter((s) => minX(s) < b && minX(s) >= (bounds[i - 1] ?? -Infinity)).join(" "));
---

<span class:list={["logo", motion !== "none" && `m-${motion}`]} style={`--h:${height}px`} data-inview={motion === "scroll" ? "" : undefined}>
  <span class="mark">
    <i class="streak" aria-hidden="true"></i><i class="streak s2" aria-hidden="true"></i>
    <svg viewBox={markView} aria-hidden="true" focusable="false"><path d={markPath} fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
  </span>
  <svg class="word" viewBox={wordView} aria-hidden="true" focusable="false">
    {letters.map((d, i) => <path d={d} fill="currentColor" fill-rule="evenodd" style={`--i:${i}`} />)}
  </svg>
  <span class="sr-only">Deza</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--h) * 0.42);
    line-height: 0;
  }

  .mark {
    position: relative;
    display: block;
  }

  .mark svg {
    position: relative;
    height: calc(var(--h) * 1.3);
    width: auto;
  }

  .word {
    height: var(--h);
    width: auto;
    overflow: hidden;
  }

  .word path {
    transform-box: fill-box;
  }

  /* Gold speed lines that trail the mark as it arrives. */
  .streak {
    position: absolute;
    right: 70%;
    top: 34%;
    width: calc(var(--h) * 2.6);
    height: max(2px, calc(var(--h) * 0.09));
    border-radius: 9px;
    background: linear-gradient(90deg, transparent, var(--gold));
    opacity: 0;
    pointer-events: none;
  }

  .streak.s2 {
    top: 62%;
    width: calc(var(--h) * 1.7);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Intro: the mark drives in, the letters rise one by one. Paced so the
       move is seen: it starts after the page paints and takes about 2.5 s. */
    .m-intro .mark svg {
      animation: drive 1.6s cubic-bezier(0.2, 0.9, 0.2, 1.06) 0.4s both;
    }

    .m-intro .streak {
      animation: streak 1.7s cubic-bezier(0.2, 0.7, 0.2, 1) 0.4s both;
    }

    .m-intro .streak.s2 {
      animation-delay: 0.6s;
    }

    .m-intro .word path {
      animation: letter 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) both;
      animation-delay: calc(1s + var(--i) * 0.12s);
    }

    .m-intro:hover .mark svg {
      animation: nudge 0.6s cubic-bezier(0.3, 0.7, 0.2, 1.2);
    }

    /* Scroll: the same moves, played once when the logo comes into view.
       (Triggered from the page script, so it works in every browser.) */
    :global(.motion-ok) .m-scroll:not(.is-in) .mark svg {
      opacity: 0;
    }

    :global(.motion-ok) .m-scroll:not(.is-in) .word path {
      transform: translateY(110%);
    }

    .m-scroll.is-in .mark svg {
      animation: drive 1.6s cubic-bezier(0.2, 0.9, 0.2, 1.04) both;
    }

    .m-scroll.is-in .streak {
      animation: streak 1.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .m-scroll.is-in .streak.s2 {
      animation-delay: 0.2s;
    }

    .m-scroll.is-in .word path {
      animation: letter 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) both;
      animation-delay: calc(0.6s + var(--i) * 0.12s);
    }
  }

  @keyframes drive {
    0% {
      opacity: 0;
      transform: translateX(-90%) skewX(-14deg);
    }
    60% {
      opacity: 1;
    }
    100% {
      transform: none;
    }
  }

  @keyframes streak {
    0% {
      opacity: 0;
      transform: translateX(-40%) scaleX(0.4);
      transform-origin: right;
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(10%) scaleX(1);
    }
  }

  @keyframes letter {
    from {
      transform: translateY(110%);
    }
  }

  @keyframes nudge {
    40% {
      transform: translateX(8%) skewX(-8deg);
    }
  }
</style>
