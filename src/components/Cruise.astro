---
// A keke and a courier cruising across the page as you scroll, past the names
// of Kano neighbourhoods. Shows only once both cut-outs are in
// public/images/cutouts/ (keke.webp and courier.webp, transparent, facing right).
import fs from "node:fs";
import path from "node:path";

interface Props {
  places: readonly string[];
}

const { places } = Astro.props;
const dir = path.join(process.cwd(), "public/images/cutouts");
const find = (n: string) => ["webp", "png"].map((e) => `${n}.${e}`).find((f) => fs.existsSync(path.join(dir, f)));
const keke = find("keke");
const courier = find("courier");
---

{
  keke && courier && (
    <section class="cruise" aria-hidden="true">
      <div class="names">
        {[...places, ...places].map((p) => (
          <span>{p}</span>
        ))}
      </div>
      <div class="road">
        <img class="v keke" src={`/images/cutouts/${keke}`} alt="" loading="lazy" decoding="async" />
        <img class="v courier" src={`/images/cutouts/${courier}`} alt="" loading="lazy" decoding="async" />
      </div>
    </section>
  )
}

<style>
  .cruise {
    position: relative;
    overflow: hidden;
    padding-block: clamp(24px, 4vw, 48px) 0;
    background: var(--paper);
  }

  .names {
    display: flex;
    gap: 0.6em;
    width: max-content;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(56px, 11vw, 168px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--ink) 16%, transparent);
    white-space: nowrap;
  }

  .road {
    position: relative;
    height: clamp(150px, 20vw, 280px);
    margin-top: calc(clamp(56px, 11vw, 168px) * -0.55);
    border-bottom: clamp(10px, 1.4vw, 18px) solid var(--ink);
  }

  /* Lane markings */
  .road::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(clamp(10px, 1.4vw, 18px) * -0.6);
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--gold) 0 28px, transparent 28px 56px);
  }

  .v {
    position: absolute;
    bottom: -2px;
    width: auto;
    filter: drop-shadow(0 10px 8px rgb(16 19 23 / 0.25));
  }

  .keke {
    height: 100%;
    left: 52%;
  }

  .courier {
    height: 82%;
    left: 18%;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .names,
      .v {
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
      }

      .names {
        animation-name: names;
      }

      .keke {
        left: 0;
        animation-name: drive-keke;
      }

      .courier {
        left: 0;
        animation-name: drive-courier;
      }
    }
  }

  @keyframes names {
    from {
      transform: translateX(-4%);
    }
    to {
      transform: translateX(-30%);
    }
  }

  @keyframes drive-keke {
    from {
      transform: translateX(-60vw);
    }
    to {
      transform: translateX(105vw);
    }
  }

  @keyframes drive-courier {
    from {
      transform: translateX(-95vw);
    }
    to {
      transform: translateX(70vw);
    }
  }
</style>
