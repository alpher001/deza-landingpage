---
// A keke and a courier cruising across the page as you scroll, past the names
// of Kano neighbourhoods. Shows only once both cut-outs are in
// src/assets/cutouts/ (keke.png and courier.png, transparent, facing right).
// They are served as sharp AVIF/WebP sized to the road.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  places: readonly string[];
}

const { places } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>("../assets/cutouts/*.png", { eager: true });
const pick = (n: string) => Object.entries(files).find(([p]) => p.endsWith(`/${n}.png`))?.[1].default;

async function cut(img: ImageMetadata | undefined) {
  if (!img) return null;
  const ws = [400, 640, 900, 1200].filter((w) => w <= img.width);
  const set = async (format: "avif" | "webp", quality: number) =>
    (await Promise.all(ws.map((width) => getImage({ src: img, width, format, quality })))).map((x, i) => `${x.src} ${ws[i]}w`).join(", ");
  const src = (await getImage({ src: img, width: 640, format: "webp", quality: 85 })).src;
  return { avif: await set("avif", 66), webp: await set("webp", 85), src, w: img.width, h: img.height };
}

const keke = await cut(pick("keke"));
const courier = await cut(pick("courier"));
const sizes = "(max-width: 750px) 220px, min(28.4vw, 400px)";
---

{
  keke && courier && (
    <section class="cruise" aria-hidden="true">
      <div class="names">
        {[...places, ...places].map((p) => (
          <span>{p}</span>
        ))}
      </div>
      <div class="road">
        {[
          ["keke", keke],
          ["courier", courier],
        ].map(([k, c]: any) => (
          <picture>
            <source type="image/avif" srcset={c.avif} sizes={sizes} />
            <source type="image/webp" srcset={c.webp} sizes={sizes} />
            <img class={`v ${k}`} src={c.src} width={c.w} height={c.h} alt="" loading="lazy" decoding="async" />
          </picture>
        ))}
      </div>
    </section>
  )
}

<style>
  .cruise {
    position: relative;
    overflow: hidden;
    padding-block: clamp(24px, 4vw, 48px) 0;
    background: var(--paper);
  }

  .names {
    display: flex;
    gap: 0.6em;
    width: max-content;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(56px, 11vw, 168px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--ink) 16%, transparent);
    white-space: nowrap;
  }

  .road {
    position: relative;
    height: clamp(150px, 20vw, 280px);
    margin-top: calc(clamp(56px, 11vw, 168px) * -0.55);
    border-bottom: clamp(10px, 1.4vw, 18px) solid var(--ink);
  }

  /* Lane markings */
  .road::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(clamp(10px, 1.4vw, 18px) * -0.6);
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--gold) 0 28px, transparent 28px 56px);
  }

  .v {
    position: absolute;
    bottom: -2px;
    width: auto;
    filter: drop-shadow(0 10px 8px rgb(16 19 23 / 0.25));
  }

  .keke {
    height: 100%;
    left: 52%;
  }

  .courier {
    height: 82%;
    left: 18%;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .names,
      .v {
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
      }

      .names {
        animation-name: names;
      }

      .keke {
        left: 0;
        animation-name: drive-keke;
      }

      .courier {
        left: 0;
        animation-name: drive-courier;
      }
    }
  }

  @keyframes names {
    from {
      transform: translateX(-4%);
    }
    to {
      transform: translateX(-30%);
    }
  }

  @keyframes drive-keke {
    from {
      transform: translateX(-60vw);
    }
    to {
      transform: translateX(105vw);
    }
  }

  @keyframes drive-courier {
    from {
      transform: translateX(-95vw);
    }
    to {
      transform: translateX(70vw);
    }
  }
</style>
