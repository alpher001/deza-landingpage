---
// Official App Store and Google Play badges, shown unchanged under a quiet
// "coming soon" line. Link them to the store listings on launch.
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="stores">
  <span class="soon">{label}</span>
  <div class="badges">
    <img src="/badges/app-store.svg" alt={`App Store, ${label}`} width="132" height="44" draggable="false" />
    <img src="/badges/google-play.png" alt={`Google Play, ${label}`} width="126" height="44" draggable="false" />
  </div>
</div>

<style>
  .stores {
    display: grid;
    justify-items: inherit;
    gap: 10px;
  }

  .soon {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    opacity: 0.7;
  }

  .badges {
    display: flex;
    gap: 10px;
  }

  .badges img {
    height: 44px;
    width: auto;
    display: block;
  }
</style>
