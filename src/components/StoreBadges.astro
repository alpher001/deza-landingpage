---
// Official App Store and Google Play badges, shown unchanged with a
// "coming soon" tag beside them. Link them to the store listings on launch.
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="stores">
  <span class="soon">{label}</span>
  <div class="badges">
    <img src="/badges/app-store.svg" alt={`App Store, ${label}`} width="132" height="44" />
    <img src="/badges/google-play.png" alt={`Google Play, ${label}`} width="126" height="44" />
  </div>
</div>

<style>
  .stores {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }

  .soon {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .soon::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ffc629;
    box-shadow: 0 0 0 4px rgb(255 198 41 / 0.25);
    animation: ping 2.4s ease-in-out infinite;
  }

  @keyframes ping {
    50% {
      box-shadow: 0 0 0 7px rgb(255 198 41 / 0);
    }
  }

  .badges {
    display: flex;
    gap: 10px;
  }

  .badges img {
    height: 44px;
    width: auto;
    display: block;
  }
</style>
