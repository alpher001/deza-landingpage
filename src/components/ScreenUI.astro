---
// A Deza app screen drawn in HTML on top of the Kano street map. It follows
// the rider app in deza-monorepo (ui-kit colours, 14/22 radii, the floating
// charcoal tab bar). Sizes use container units, so the screen scales with
// whatever holds it (1cqw is about 4pt on a real phone).
//
// mode "ride": three states that follow the "How it works" steps through the
//   nearest [data-step] attribute.
// mode "delivery": a package being tracked, with the dispatch rider moving on the map.
import Icon from "./Icon.astro";
import map from "../generated/kano-map.json";
import type { copy } from "../i18n";

type Lang = keyof typeof copy;

interface Props {
  t: (typeof copy)[Lang]["screen"];
  mode?: "ride" | "delivery";
}

const { t, mode = "ride" } = Astro.props;
const [rideA, rideB] = map.rideEnds;
const [delA, delB] = map.deliveryEnds;

// Map vehicles, drawn nose up in map units, so the camera scales them with
// the streets. Each one's outline is also drawn in white (a sticker edge that
// keeps it readable over the route line and the gold roads) and blurred (its
// shadow).
//
// Keke napep: ink body narrowing to the front cowl, gold canopy with a darker
// front lip, one front wheel and two rear wheels showing.
const kekeBody =
  "M0 -17.6C2.4 -17.6 3.9 -16.8 4.3 -14.8L5.2 -9.4C5.5 -8 6.6 -7.4 8.2 -7.2C8.8 -7.1 9.1 -6.6 9.1 -5.8V12.6C9.1 14 8.1 15 6.7 15H-6.7C-8.1 15 -9.1 14 -9.1 12.6V-5.8C-9.1 -6.6 -8.8 -7.1 -8.2 -7.2C-6.6 -7.4 -5.5 -8 -5.2 -9.4L-4.3 -14.8C-3.9 -16.8 -2.4 -17.6 0 -17.6Z";
const kekeCanopy = "M-7.7 -5.4Q-7.7 -7.2 -6 -7.6Q0 -9.4 6 -7.6Q7.7 -7.2 7.7 -5.4V11.8Q7.7 13.6 5.9 13.6H-5.9Q-7.7 13.6 -7.7 11.8Z";
const kekeLip = "M-7.7 -5.4Q-7.7 -7.2 -6 -7.6Q0 -9.4 6 -7.6Q7.7 -7.2 7.7 -5.4V-4Q0 -7.4 -7.7 -4Z";
// Set a little behind its point on the route, so where the approach ends the
// nose stops just short of the pickup pin rather than running over it.
const kekeFit = "translate(0 6)";
// Dispatch rider: front wheel and headlamp, bars, tank, the rider (arms out
// to the grips, shoulders, helmet) and the top box over the rear wheel. Drawn
// a touch larger, as the delivery phone is the smaller of the two.
const bikeFit = "scale(1.1)";
const bikeNose = "M-3.4 -11.6L-3.8 -13.6Q-3.6 -16.4 0 -16.6Q3.6 -16.4 3.8 -13.6L3.4 -11.6Z";
const riderArms =
  "M-7.6 0.4Q-10.6 -5 -9.7 -10.5A1.45 1.45 0 0 1 -6.9 -11.1Q-7.8 -5.6 -4.9 -1.4ZM7.6 0.4Q10.6 -5 9.7 -10.5A1.45 1.45 0 0 0 6.9 -11.1Q7.8 -5.6 4.9 -1.4Z";
---

<div class="scr" data-mode={mode} aria-hidden="true">
  <!-- The camera pans and zooms this whole box (a composited transform). It
       holds three layers: the street map, which never changes after it is
       drawn; the routes and pins over it; and the vehicle, an HTML layer the
       compositor moves along the route. One unit of the 400 x 1000 map is
       0.25cqw, so the box is 100cqw by 250cqw. -->
  <div class="cam">
    <svg class="streets" viewBox="0 0 400 1000">
      <use href="/map.svg#kano-map" width="400" height="1000"></use>
    </svg>
    <svg class="overlay" viewBox="0 0 400 1000">
      {
        mode === "ride" ? (
          <>
            <path class="route-case" d={map.ride} pathLength="1" />
            <path class="route" d={map.ride} pathLength="1" />
            <path class="approach" d={map.approach} data-track />
            <g class="pin-me" transform={`translate(${rideA[0]} ${rideA[1]})`}>
              <circle class="halo" r="16" />
              <circle r="8.5" class="ring" />
              <circle r="4" class="core" />
            </g>
            <g class="pin-to" transform={`translate(${rideB[0]} ${rideB[1]})`}>
              <rect x="-8" y="-8" width="16" height="16" rx="3" />
              <rect x="-3.5" y="-3.5" width="7" height="7" rx="1" class="in" />
            </g>
            <g class="tag tag-to" transform={`translate(${rideB[0] - 108} ${rideB[1] - 16})`}>
              <rect width="94" height="32" rx="9" />
              <text x="12" y="13.5" class="t1">{t.toValue}</text>
              <text x="12" y="25.5" class="t2">{t.tripTime}</text>
            </g>
          </>
        ) : (
          <>
            <path class="route-case" d={map.delivery} pathLength="1" />
            <path class="route" d={map.delivery} pathLength="1" data-track />
            <g class="pin-from" transform={`translate(${delA[0]} ${delA[1]})`}>
              <circle r="8.5" class="ring" />
              <circle r="4" class="core" />
            </g>
            <g class="pin-to" transform={`translate(${delB[0]} ${delB[1]})`}>
              <rect x="-8" y="-8" width="16" height="16" rx="3" />
              <rect x="-3.5" y="-3.5" width="7" height="7" rx="1" class="in" />
            </g>
          </>
        )
      }
    </svg>
    {
      mode === "ride" ? (
        <div class="mover keke" data-mover>
          <svg class="sprite" viewBox="-36 -36 72 72" data-shade>
            <defs>
              <filter id="dz-soft-ride" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="1.3" />
              </filter>
              <g id="dz-keke" transform={kekeFit}>
                <rect x="-1.7" y="-20.4" width="3.4" height="7" rx="1.7" />
                <rect x="-10.6" y="5" width="21.2" height="6.6" rx="2" />
                <path d={kekeBody} />
              </g>
            </defs>
            <use href="#dz-keke" class="shade" filter="url(#dz-soft-ride)" />
          </svg>
          <svg class="sprite" viewBox="-36 -36 72 72" data-body>
            <use href="#dz-keke" class="keyline" />
            <g transform={kekeFit}>
              <rect x="-1.7" y="-20.4" width="3.4" height="7" rx="1.7" class="ink" />
              <rect x="-10.6" y="5" width="21.2" height="6.6" rx="2" class="ink" />
              <path d={kekeBody} class="ink" />
              <path d={kekeCanopy} class="canopy" />
              <path d={kekeLip} class="lip" />
              <ellipse cy="-15.4" rx="1.9" ry="1.05" class="lamp" />
            </g>
          </svg>
        </div>
      ) : (
        <div class="mover courier" data-mover>
          <svg class="sprite" viewBox="-36 -36 72 72" data-shade>
            <defs>
              <filter id="dz-soft-delivery" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="1.3" />
              </filter>
              <g id="dz-bike" transform={bikeFit}>
                <rect x="-2" y="-23.4" width="4" height="10" rx="2" />
                <rect x="-2" y="16" width="4" height="8" rx="2" />
                <path d={bikeNose} />
                <rect x="-10" y="-12.4" width="20" height="2.6" rx="1.3" />
                <ellipse cy="-6.2" rx="3.6" ry="5.2" />
                <path d={riderArms} />
                <rect x="-7.4" y="-3.6" width="14.8" height="8.8" rx="4.2" />
                <rect x="-8.6" y="3.6" width="17.2" height="16.2" rx="2.6" />
              </g>
            </defs>
            <use href="#dz-bike" class="shade" filter="url(#dz-soft-delivery)" />
          </svg>
          <svg class="sprite" viewBox="-36 -36 72 72" data-body>
            <use href="#dz-bike" class="keyline" />
            <g transform={bikeFit}>
              <rect x="-2" y="-23.4" width="4" height="10" rx="2" class="ink" />
              <rect x="-2" y="16" width="4" height="8" rx="2" class="ink" />
              <path d={bikeNose} class="ink" />
              <ellipse cy="-14.6" rx="1.7" ry="0.9" class="lamp" />
              <rect x="-10" y="-12.4" width="20" height="2.6" rx="1.3" class="ink" />
              <ellipse cy="-6.2" rx="3.6" ry="5.2" class="ink" />
              <path d={riderArms} class="ink" />
              <rect x="-7.4" y="-3.6" width="14.8" height="8.8" rx="4.2" class="ink" />
              <circle cy="-1.4" r="4.5" class="helmet" />
              <path d="M-2.9 -4.8Q0 -6.5 2.9 -4.8" class="visor" />
              <rect x="-8.6" y="3.6" width="17.2" height="16.2" rx="2.6" class="box" />
              <rect x="-8.6" y="9.4" width="17.2" height="5" class="band" />
            </g>
          </svg>
        </div>
      )
    }
  </div>

  <div class="status">
    <span>9:41</span>
    <span class="island"></span>
    <span class="sig"><i></i><i></i><i></i><i></i></span>
  </div>

  {
    mode === "ride" ? (
      <>
        <div class="float-top">
          <span class="round">
            <Icon name="menu" size={18} stroke={2} />
          </span>
          <span class="round">
            <Icon name="locate" size={18} stroke={2} />
          </span>
        </div>

        <div class="sheet">
          <span class="grab" />

          <div class="state s1">
            <p class="hello">{t.greet}</p>
            <div class="trip">
              <div class="trip-row">
                <i class="dot a" />
                <div>
                  <small>{t.from}</small>
                  <b>{t.fromValue}</b>
                </div>
              </div>
              <div class="trip-row typing">
                <i class="dot b" />
                <div>
                  <small>{t.to}</small>
                  <b>
                    {t.toValue}
                    <span class="caret" />
                  </b>
                </div>
              </div>
            </div>
            <ul class="recent">
              {t.recent.map(([place, area]) => (
                <li>
                  <span class="ico">
                    <Icon name="clock" size={14} stroke={2} />
                  </span>
                  <div>
                    <b>{place}</b>
                    <small>{area}</small>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <div class="state s2">
            <p class="h">{t.choose}</p>
            <div class="option on">
              <span class="veh">
                <svg viewBox="0 0 40 28">
                  <path d="M6 20V11a6 6 0 0 1 6-6h12l7 6h3a2 2 0 0 1 2 2v7" class="v-body" />
                  <path d="M12 5h12v8H9v-2a6 6 0 0 1 3-6" class="v-roof" />
                  <circle cx="11" cy="21" r="3.6" class="v-wheel" />
                  <circle cx="31" cy="21" r="3.6" class="v-wheel" />
                </svg>
              </span>
              <div>
                <b>{t.keke}</b>
                <small>{t.kekeSub}</small>
              </div>
              <b class="price">₦600</b>
            </div>
            <div class="option off">
              <span class="veh">
                <Icon name="package" size={18} stroke={1.75} />
              </span>
              <div>
                <b>{t.parcel}</b>
                <small>{t.parcelSub}</small>
              </div>
              <span class="soon">{t.soon}</span>
            </div>
            <div class="pay">
              <Icon name="banknote" size={16} stroke={2} />
              <b>{t.cash}</b>
              <span>{t.change}</span>
            </div>
            <div class="cta">{t.button}</div>
          </div>

          <div class="state s3">
            <div class="eta-row">
              <div>
                <p class="h">{t.eta}</p>
                <small>{t.meet}</small>
              </div>
              <span class="mins">
                3<small>{t.min}</small>
              </span>
            </div>
            <div class="driver">
              <img src="/images/app/driver-face.webp" alt="" width="72" height="72" loading="lazy" decoding="async" />
              <div>
                <b>{t.driver}</b>
                <small>{t.vehicle}</small>
              </div>
              <span class="plate">{t.plate}</span>
            </div>
            <div class="acts">
              <span>
                <i>
                  <Icon name="phone" size={16} stroke={2} />
                </i>
                {t.call}
              </span>
              <span>
                <i>
                  <Icon name="message" size={16} stroke={2} />
                </i>
                {t.chat}
              </span>
              <span>
                <i>
                  <Icon name="share" size={16} stroke={2} />
                </i>
                {t.share}
              </span>
            </div>
          </div>
        </div>

        <div class="tabbar">
          <span class="on">
            <Icon name="home" size={20} />
            <i />
          </span>
          <span>
            <Icon name="wallet" size={20} />
            <i />
          </span>
          <span>
            <Icon name="user" size={20} />
            <i />
          </span>
        </div>
      </>
    ) : (
      <div class="sheet dsheet">
        <span class="grab" />
        <div class="eta-row">
          <div>
            <p class="h">{t.dTitle}</p>
            <small>{t.dEta}</small>
          </div>
          <span class="mins">
            12<small>{t.min}</small>
          </span>
        </div>
        <ol class="progress">
          {t.dSteps.map((s, i) => (
            <li class:list={[{ done: i === 0, now: i === 1 }]}>
              <i />
              {s}
            </li>
          ))}
        </ol>
        <div class="driver">
          <span class="avatar">
            <Icon name="package" size={18} stroke={1.75} />
          </span>
          <div>
            <b>{t.dCourier}</b>
            <small>{t.dItem}</small>
          </div>
          <span class="plate">{t.dPlate}</span>
        </div>
        <div class="code">
          <div>
            <small>{t.dCode}</small>
            <span class="hint">{t.dCodeHint}</span>
          </div>
          <b>4827</b>
        </div>
      </div>
    )
  }
</div>

<script>
  // Moves the keke or dispatch rider along its route, facing the road. The
  // whole drive is worked out once and handed to the compositor as a Web
  // Animation, so nothing runs on the main thread (or repaints the map)
  // while the vehicle moves.
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>(".scr").forEach((scr) => {
    const path = scr.querySelector<SVGPathElement>("[data-track]");
    const mover = scr.querySelector<HTMLElement>("[data-mover]");
    const shade = mover?.querySelector<SVGSVGElement>("[data-shade]");
    const body = mover?.querySelector<SVGSVGElement>("[data-body]");
    if (!path || !mover || !shade || !body) return;
    const len = path.getTotalLength();
    const ride = scr.dataset.mode === "ride";

    // Points and heading along the route, sampled every STEP map units. The
    // routes are polylines of short segments, so the raw direction kicks at
    // every vertex and snaps round corners. Smoothing the unwrapped angle over
    // REACH samples either side (about 12 units, a third of a vehicle) spreads
    // each turn evenly across that stretch, so the vehicle steers through a
    // corner, even a hairpin, instead of jittering or flicking round. Built on
    // first use, so it costs nothing until the screen is on view.
    const STEP = 3;
    const REACH = 4;
    const n = Math.max(2, Math.ceil(len / STEP) + 1);
    let track: { pts: DOMPoint[]; heading: Float64Array } | undefined;

    const build = () => {
      const pts = Array.from({ length: n }, (_, i) => path.getPointAtLength(Math.min(len, i * STEP)));
      const raw = new Float64Array(n);
      let dir = NaN;
      let first = -1;
      for (let i = 0; i < n; i++) {
        const a = pts[Math.min(i, n - 2)];
        const b = pts[Math.min(i + 1, n - 1)];
        if (Math.hypot(b.x - a.x, b.y - a.y) > 1e-3) {
          const h = Math.atan2(b.y - a.y, b.x - a.x);
          dir = first < 0 ? h : dir + Math.atan2(Math.sin(h - dir), Math.cos(h - dir));
          if (first < 0) first = i;
        }
        raw[i] = dir; // a repeated point keeps the direction before it
      }
      raw.fill(first < 0 ? -Math.PI / 2 : raw[first], 0, Math.max(0, first));
      const heading = new Float64Array(n);
      for (let i = 0; i < n; i++) {
        let sum = 0;
        for (let j = -REACH; j <= REACH; j++) {
          sum += raw[Math.min(n - 1, Math.max(0, i + j))] * (REACH + 1 - Math.abs(j));
        }
        heading[i] = sum / ((REACH + 1) * (REACH + 1));
      }
      return { pts, heading };
    };

    // The vehicle's transforms at fraction k of the route: the body, and its
    // soft shadow, which sits a little down and right in map space however
    // the vehicle turns. One map unit is 0.25cqw.
    const at = (k: number) => {
      track ??= build();
      const { pts, heading } = track;
      const s = Math.min(len, Math.max(0, k * len));
      const f = Math.min(n - 1, s / STEP);
      const i = Math.min(n - 2, Math.floor(f));
      const u = f - i;
      const x = pts[i].x + (pts[i + 1].x - pts[i].x) * u;
      const y = pts[i].y + (pts[i + 1].y - pts[i].y) * u;
      const h = heading[i] + (heading[i + 1] - heading[i]) * u;
      // The art is drawn nose up, so add a quarter turn.
      const rot = `rotate(${((h * 180) / Math.PI + 90).toFixed(2)}deg)`;
      const q = (v: number) => (v * 0.25).toFixed(3) + "cqw";
      return [`translate(${q(x)}, ${q(y)}) ${rot}`, `translate(${q(x + 1.4)}, ${q(y + 2.4)}) ${rot}`];
    };

    // Ride: the keke drives toward the pickup and stops just short of it.
    // Delivery: the rider loops along the whole route, waits at the drop-off,
    // then fades out and back in at the market rather than jumping between them.
    const dur = ride ? 7000 : 14000;
    const end = ride ? 0.94 : 1;
    const rest = ride ? 0 : 1200;
    const cycle = dur + rest;
    const ease = (x: number) => (x < 0.5 ? 2 * x * x : 1 - Math.pow(-2 * x + 2, 2) / 2);
    let anims: Animation[] = [];

    const play = () => {
      anims.forEach((a) => a.cancel());
      anims = [];
      if (reduce) {
        [body.style.transform, shade.style.transform] = at(end * 0.7);
        return;
      }
      // About one key per frame at 40 fps: close enough together that the
      // straight steps between them follow the road and the turns.
      const keys = Math.ceil(dur / 25);
      const bodyKeys: Keyframe[] = [];
      const shadeKeys: Keyframe[] = [];
      for (let j = 0; j <= keys; j++) {
        const [b, sh] = at(ease(j / keys) * end);
        const offset = (dur * j) / keys / cycle;
        bodyKeys.push({ transform: b, offset });
        shadeKeys.push({ transform: sh, offset });
      }
      if (rest) {
        bodyKeys.push({ ...bodyKeys[keys], offset: 1 });
        shadeKeys.push({ ...shadeKeys[keys], offset: 1 });
      }
      const timing: KeyframeAnimationOptions = ride
        ? { duration: cycle, fill: "forwards" }
        : { duration: cycle, iterations: Infinity };
      anims = [body.animate(bodyKeys, timing), shade.animate(shadeKeys, timing)];
      if (!ride) {
        // 350 ms before each restart, fade out over 0.3 s; then fade back in
        // over 0.3 s as the next lap starts.
        const o = (ms: number) => ms / cycle;
        anims.push(
          mover.animate(
            [
              { opacity: 1, offset: 0, easing: "ease" },
              { opacity: 0, offset: o(300) },
              { opacity: 0, offset: o(350), easing: "ease" },
              { opacity: 1, offset: o(650) },
              { opacity: 1, offset: 1 },
            ],
            { duration: cycle, iterations: Infinity, delay: cycle - 350 },
          ),
        );
      }
      const t0 = document.timeline.currentTime;
      if (t0 !== null) anims.forEach((a) => (a.startTime = t0));
    };

    // Off screen, the small looping details (pin pulse, cursor, progress
    // bar) and the delivery rider pause too, so they cost nothing while you
    // read elsewhere.
    new IntersectionObserver((entries) => {
      const visible = entries[entries.length - 1].isIntersecting;
      scr.classList.toggle("off", !visible);
      if (ride) return;
      if (visible) play();
      else anims.forEach((a) => a.pause());
    }).observe(scr);

    // The ride screen restarts the keke each time step 3 comes up.
    const host = scr.closest<HTMLElement>("[data-step]");
    if (ride && host) {
      new MutationObserver(() => {
        if (host.dataset.step === "3") play();
      }).observe(host, { attributes: true, attributeFilter: ["data-step"] });
    }
  });
</script>

<style>
  .scr.off *,
  .scr.off *::before {
    animation-play-state: paused !important;
  }

  .scr {
    container-type: inline-size;
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 9% / 4.2%;
    background: #efe9da;
    color: #1e2329;
    font-family: var(--font);
    line-height: 1.25;
  }

  /* Map and camera. The camera box is the 400 x 1000 map at the screen's
     width (1 map unit = 0.25cqw), and the shots below are in map units
     times 0.25cqw. */
  .cam {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 250cqw;
    transform-origin: 0 0;
    transition: transform 1.3s cubic-bezier(0.6, 0, 0.2, 1);
    transform: translate(-48.25cqw, -14.5cqw) scale(1.5);
  }

  :global([data-step="2"]) [data-mode="ride"] .cam {
    transform: translate(0, -24cqw) scale(1);
  }

  :global([data-step="3"]) [data-mode="ride"] .cam {
    transform: translate(-18cqw, -21cqw) scale(1.36);
  }

  [data-mode="delivery"] .cam {
    transform: translate(-2cqw, -13cqw) scale(1.02);
  }

  .streets,
  .overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    font-family: var(--font);
  }

  /* Its own layer, so the pin pulse and route drawing never repaint the
     street map under it. */
  .overlay {
    will-change: transform;
  }

  .route-case {
    fill: none;
    stroke: #fff;
    stroke-width: 10;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .route {
    fill: none;
    stroke: #1e2329;
    stroke-width: 5.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  [data-mode="ride"] .route,
  [data-mode="ride"] .route-case {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.4s cubic-bezier(0.65, 0, 0.35, 1) 0.3s;
  }

  :global([data-step="2"]) [data-mode="ride"] .route,
  :global([data-step="2"]) [data-mode="ride"] .route-case {
