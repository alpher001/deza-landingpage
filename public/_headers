# Cloudflare Pages caching. Hashed build files never change, so browsers keep
# them for a year. Fonts, videos and the map change rarely: a week.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=604800
  Access-Control-Allow-Origin: *
/video/*
  Cache-Control: public, max-age=604800
/map.svg
  Cache-Control: public, max-age=604800
