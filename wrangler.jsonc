// Cloudflare Workers settings. `npx wrangler deploy` (run by Cloudflare after
// `npm run build`) uploads dist/ as the site and worker/index.ts for /api/*.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deza-landingpage",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown addresses get the 404 page (src/pages/404.astro), status 404.
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Worker logs in the dashboard (free plan: kept 3 days). Set here, because a
  // switch flipped only in the dashboard is turned off again by the next deploy.
  "observability": { "logs": { "enabled": true, "invocation_logs": true } },
  // Waitlist database (Cloudflare D1). Bound here, not in the dashboard: a
  // dashboard-only binding is removed by the next deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "deza-waitlist", "database_id": "c7041677-d48e-41de-8e4b-8c89ccf131f9" }]
}
